/* Renomeia apenas estados atuais. Histórico original e dados comerciais preservados. */
const EC_OPCOES=['Por verificar','Falta no eGO > ver dossier','No dossier > digitalizar','Digitalizado','Falta no eGO + dossier','Categoria errada','Formato errado','Preenchido','N/A','Em falta'];
function ecCurto_(v){return ({'Em falta no eGO · verificar dossier':EC_OPCOES[1],'No dossier · por digitalizar':EC_OPCOES[2],'Em falta no eGO e no dossier':EC_OPCOES[4],'Não aplicável':'N/A'})[v]||v;}
function encurtarEstadosDocumentais(){
 const lock=LockService.getDocumentLock();if(!lock.tryLock(5000))throw Error('Outra gravação em curso.');
 try{const ss=SpreadsheetApp.getActive(),s=ss.getSheetByName(LEV.nome),h=s.getRange(9,1,1,s.getLastColumn()).getDisplayValues()[0],n=s.getLastRow()-9,requests=[],logs=[],meta=edSheets_(ss,'?fields=sheets(properties(sheetId,title),tables)'),colunas=ED_CAMPOS.map(x=>{const col=h.indexOf(x[1]);if(col<0)throw Error('Coluna em falta: '+x[1]);return col;});
 const values=s.getRange(10,1,n,h.length).getValues(),forms=s.getRange(10,1,n,h.length).getFormulas(),refs=values.map(r=>r[0]),sheetMeta=meta.sheets.find(x=>x.properties.sheetId===s.getSheetId());
 const tables=new Map();colunas.forEach(col=>{const tab=(sheetMeta.tables||[]).find(t=>col>=(t.range.startColumnIndex||0)&&col<t.range.endColumnIndex);if(!tab)throw Error('Tabela documental não encontrada.');if(!tables.has(tab.tableId))tables.set(tab.tableId,JSON.parse(JSON.stringify(tab)));const t=tables.get(tab.tableId),cp=t.columnProperties.find(p=>p.columnIndex===col-(t.range.startColumnIndex||0));if(!cp)throw Error('Coluna tipada não encontrada.');cp.columnType='DROPDOWN';cp.dataValidationRule={condition:{type:'ONE_OF_LIST',values:EC_OPCOES.map(v=>({userEnteredValue:v}))}};});
 tables.forEach(t=>requests.push({updateTable:{table:{tableId:t.tableId,columnProperties:t.columnProperties},fields:'columnProperties'}}));
 function cell(sheetId,row,col,value,formula){requests.push({updateCells:{range:{sheetId,startRowIndex:row-1,endRowIndex:row,startColumnIndex:col,endColumnIndex:col+1},rows:[{values:[{userEnteredValue:formula?{formulaValue:value}:{stringValue:String(value)}}]}],fields:'userEnteredValue'}});}
 values.forEach((r,i)=>{if(!r[0])return;colunas.forEach(col=>{const v=ecCurto_(r[col]);if(v!==r[col]&&!forms[i][col]){cell(s.getSheetId(),i+10,col,v,false);logs.push([r[0],LEV.nome,h[col]+' · linha '+(i+10),r[col],v]);}});});
 // Fórmulas referem os mesmos estados abreviados, incluindo N/A; não altera fórmulas de pendências.
 forms.forEach((r,i)=>r.forEach((f,col)=>{if(!f)return;const novo=f.replace(/"Em falta no eGO · verificar dossier"/g,'"Falta no eGO > ver dossier"').replace(/"No dossier · por digitalizar"/g,'"No dossier > digitalizar"').replace(/"Em falta no eGO e no dossier"/g,'"Falta no eGO + dossier"');const final=f.includes('PendenciasEquipe[')?novo.replace(/"N\/A"/g,'"Não aplicável"'):novo.replace(/"Não aplicável"/g,'"N/A"');if(final!==f)cell(s.getSheetId(),i+10,col,final,true);}));
 const ps=ss.getSheetByName(PEND.nome),pn=ps.getLastRow()-5,pv=ps.getRange(6,1,pn,17).getValues();pv.forEach((r,i)=>{if(!r[0]||r[8]==='Não aplicável')return;const novo=ecCurto_(r[8]);if(novo!==r[8]){cell(ps.getSheetId(),i+6,8,novo,false);logs.push([r[1],PEND.nome,'Estado · '+r[0],r[8],novo]);}});
 const pm=meta.sheets.find(x=>x.properties.sheetId===ps.getSheetId());(pm.tables||[]).forEach(tab=>{const t=JSON.parse(JSON.stringify(tab)),cp=t.columnProperties.find(p=>p.columnIndex===8-(t.range.startColumnIndex||0));if(!cp||!cp.dataValidationRule)return;const vs=cp.dataValidationRule.condition.values||[];cp.dataValidationRule.condition.values=[...new Set(vs.map(v=>v.userEnteredValue==='Não aplicável'?'Não aplicável':ecCurto_(v.userEnteredValue)))].map(v=>({userEnteredValue:v}));requests.push({updateTable:{table:{tableId:t.tableId,columnProperties:t.columnProperties},fields:'columnProperties'}});});
 if(logs.length){const hs=ss.getSheetByName('Registo de alterações'),start=hs.getLastRow(),data=Utilities.formatDate(new Date(),ss.getSpreadsheetTimeZone(),'yyyy-MM-dd'),rows=logs.map(l=>({values:[data,l[0],'','Equipa',l[1],l[2],String(l[3]),String(l[4]),'Abreviação de estados pedida pela Andreia; significado preservado.','Confirmado','',''].map(v=>({userEnteredValue:{stringValue:v}}))}));if(start+rows.length>hs.getMaxRows())requests.push({appendDimension:{sheetId:hs.getSheetId(),dimension:'ROWS',length:start+rows.length-hs.getMaxRows()+100}});requests.push({updateCells:{range:{sheetId:hs.getSheetId(),startRowIndex:start,endRowIndex:start+rows.length,startColumnIndex:0,endColumnIndex:12},rows,fields:'userEnteredValue'}});}
 edSheets_(ss,':batchUpdate',{requests});SpreadsheetApp.flush();const after=s.getRange(10,1,n,h.length).getDisplayValues();let longos=0;after.forEach(r=>colunas.forEach(c=>{if(ecCurto_(r[c])!==r[c])longos++;}));if(longos)throw Error('Restam estados longos; rever a atualização.');const result={celulasRenomeadas:logs.length,opcoes:EC_OPCOES,estadosLongosRestantes:longos,referenciasPreservadas:after.every((r,i)=>r[0]===String(refs[i]||''))};console.log(JSON.stringify(result));return result;
 }finally{lock.releaseLock();}
}
