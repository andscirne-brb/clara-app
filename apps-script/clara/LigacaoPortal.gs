function prepararLigacaoPortal_(texto,ss){
 if(typeof texto!=='string'||texto.length>5000||!texto.startsWith('CLARA5:'))throw Error('Leitura da ligação inválida.');const x=JSON.parse(texto.slice(7)),portal={'green-acres':'Green-Acres',rightmove:'Rightmove'}[x.origem],ref=ipRef_(x.refEgo);
 if(x.v!==5||x.tipo!=='ligacao'||!portal||!/^\d{1,20}$/.test(x.id||'')||!/^[A-Z]{0,6}[ _-]?\d{3,10}(?:[_-][A-Z0-9]{1,8})?$/.test(ref)||typeof x.lido!=='string'||!/^\d{4}-\d{2}-\d{2}T/.test(x.lido)||!Number.isFinite(Date.parse(x.lido))||!ipUrl_(portal,x.id,x.url))throw Error('Origem ou referência inválida.');if(portal==='Rightmove'&&x.url!==ipUrl_(portal,x.id))throw Error('A ligação não coincide com o anúncio.');
 const old=ipTabela_(ss,'Ligações dos portais',9,IP_LIGACOES),index=old.findIndex(r=>r[0]===portal&&String(r[1])===x.id);if(index<0)throw Error('Este anúncio ainda não está nas recolhas. Recolhe primeiro a lista ou o desempenho do portal.');const row=old[index].slice();if(portal==='Green-Acres'&&/\/([A-Za-z0-9]+)\.htm$/.exec(x.url)[1].toLowerCase()!==/\/([A-Za-z0-9]+)\.htm$/.exec(row[6])[1].toLowerCase())throw Error('O endereço corresponde a outro anúncio.');const ego=ipEgo_(ss),estado=ipEstado_(ref,ego),conflito=row[3]&&ipRef_(row[3])!==ref;
 if(conflito){row[4]='Conflito de referências';row[8]='A referência lida no navegador diverge da ligação anterior; revisão necessária.';}else{row[3]=ref;row[4]=estado;row[5]=portal==='Green-Acres'?'Número de mandato lido na ficha pelo marcador':'#ref lida na ficha pelo marcador';row[7]=Utilities.formatDate(new Date(),ss.getSpreadsheetTimeZone(),'yyyy-MM-dd');row[8]='';}
 const rows=old.map((r,i)=>i===index?row:r);return{old,rows,ref,portal,origem:x.origem,estado:row[4],ego};
}
function analisarLigacaoPortal(texto){const p=prepararLigacaoPortal_(texto,SpreadsheetApp.getActive());return{origem:p.origem,tipo:'ligacao',portal:p.portal,ref:p.ref,estado:p.estado,quantidade:1,destino:'Ligações dos portais',aviso:p.estado==='Confirmada'?'A referência existe uma única vez no levantamento.':'A associação não será usada na ficha enquanto estiver por rever.'};}
function gravarLigacaoPortal(texto){const lock=LockService.getDocumentLock();if(!lock.tryLock(1000))throw Error('Outra gravação em curso.');try{const ss=SpreadsheetApp.getActive(),p=prepararLigacaoPortal_(texto,ss),alteradas=ipGuardarLigacoes_(ss,p.old,p.rows);ipEscrever_(ss,'Imóveis nos portais',IP_VISTA,ipVista_(p.ego,p.rows));return{origem:p.origem,tipo:'ligacao',escritos:alteradas,duplicada:!alteradas,cobertura:'Ligação '+p.estado.toLowerCase()+'. Histórico preservado; dados eGO não alterados.'};}finally{lock.releaseLock();}}
