const RM_CSV_HEADERS=['Data da recolha','Dados atualizados até','Anúncios','Janelas (dias)','Origem','Aviso da fonte','ID da importação'];
function validarRightmoveCSV_(x){
 if(!Array.isArray(x.lotes)||x.lotes.length!==3||typeof x.avisoFonte!=='string'||x.avisoFonte.length>1000)throw Error('CSV sem as três janelas ou aviso inválido.');const lotes=x.lotes.map(l=>validarLeituraRightmove_('CLARA3:'+JSON.stringify({v:3,origem:'rightmove',tipo:'performance',lido:x.lido,url:x.url,atualizado:x.atualizado,total:x.total,janela:l.janela,mediaAgencia:l.mediaAgencia,registos:l.registos}))).sort((a,b)=>a.janela-b.janela);
 if(lotes.map(l=>l.janela).join(',')!=='30,60,90'||lotes.some(l=>l.registos.map(r=>r.id).join(',')!==lotes[0].registos.map(r=>r.id).join(',')))throw Error('As janelas não correspondem à mesma carteira.');return{tipo:'performance_csv',lido:lotes[0].lido,url:lotes[0].url,atualizado:lotes[0].atualizado,total:lotes[0].total,avisoFonte:x.avisoFonte,lotes};
}
function prepararRightmoveCSV_(d,ss){
 const partes=d.lotes.map(l=>prepararRightmove_('CLARA3:'+JSON.stringify(Object.assign({v:3,origem:'rightmove'},l)),ss)),metaNome='Rightmove - importações CSV',meta=ss.getSheetByName(metaNome),assinatura=JSON.stringify([d.atualizado,d.total,d.avisoFonte,partes.map(p=>p.hash)]),hash=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,assinatura,Utilities.Charset.UTF_8).map(x=>('0'+(x&255).toString(16)).slice(-2)).join('');
 if(meta&&meta.getRange(1,1,1,RM_CSV_HEADERS.length).getDisplayValues()[0].join('|')!==RM_CSV_HEADERS.join('|'))throw Error('Estrutura do registo CSV alterada.');const ja=meta&&meta.getLastRow()>1&&meta.getRange(2,7,meta.getLastRow()-1,1).getValues().some(r=>r[0]===hash);if(ja&&!partes.every(p=>p.duplicada))throw Error('Importação CSV incompleta. Confere o histórico antes de repetir.');return{d,nome:'Rightmove - desempenho',headers:RM_PERF_HEADERS,partes,linhas:partes.filter(p=>!p.duplicada).flatMap(p=>p.linhas),duplicada:!!ja&&partes.every(p=>p.duplicada),quantidade:d.total,metaNome,metaLinha:[d.lido,d.atualizado,d.total,'30 / 60 / 90','CSV oficial Rightmove',d.avisoFonte,hash]};
}
function gravarRightmoveCSVDados_(p,ss){
 if(p.duplicada)return{origem:'rightmove',duplicada:true,escritos:0,quantidade:p.quantidade};const plans=[];
 [[p.nome,p.headers,p.linhas],[p.metaNome,RM_CSV_HEADERS,[p.metaLinha]]].forEach(([nome,headers,linhas])=>{if(!linhas.length)return;let sh=ss.getSheetByName(nome);if(!sh){sh=ss.insertSheet(nome);sh.getRange(1,1,1,headers.length).setValues([headers]).setBackground('#183746').setFontColor('#ffffff').setFontWeight('bold');sh.setFrozenRows(1);sh.setColumnWidths(1,headers.length,145);}const inicio=sh.getLastRow()+1;if(sh.getMaxRows()<inicio+linhas.length-1)sh.insertRowsAfter(sh.getMaxRows(),inicio+linhas.length-1-sh.getMaxRows());plans.push({sh,inicio,linhas,w:headers.length});});
 const tentados=[];try{plans.forEach(p=>{tentados.push(p);p.sh.getRange(p.inicio,1,p.linhas.length,p.w).setValues(p.linhas.map(r=>r.map(v=>typeof v==='string'?"'"+v:v)));});SpreadsheetApp.flush();plans.forEach(p=>{const range=p.sh.getRange(p.inicio,1,p.linhas.length,p.w);if(JSON.stringify(range.getValues())!==JSON.stringify(p.linhas)||range.getFormulas().some(r=>r.some(Boolean)))throw Error('Conferência da importação CSV falhou.');});}catch(e){let falhas=0;tentados.reverse().forEach(p=>{try{p.sh.getRange(p.inicio,1,p.linhas.length,p.w).clearContent();}catch(err){falhas++;}});SpreadsheetApp.flush();if(falhas)throw Error('A importação falhou e a reposição ficou incompleta. Confere o histórico antes de repetir.');throw e;}
 return{origem:'rightmove',duplicada:false,escritos:p.linhas.length,quantidade:p.quantidade,cobertura:p.quantidade+' anúncios · janelas de 30, 60 e 90 dias. '+(p.d.avisoFonte||'')};
}
