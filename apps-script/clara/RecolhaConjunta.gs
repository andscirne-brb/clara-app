function verificarConjuntoIdealista(){const dia='2000-01-01',base={v:2,origem:'idealista',url:'https://www.idealista.pt/webtool/stats/loadImpactStats',lido:dia,periodo:{inicio:dia,fim:dia},filtros:['Teste sintético'],cobertura:'Diagnóstico sem importação'},geral=Object.assign({},base,{tipo:'geral',registos:[{id:'carteira',ref:'',metricas:{contactos:0,mensagens:0,chamadas:0,anunciosAtivosHoje:0}}],diarios:[{data:dia,contactos:0,mensagens:0,chamadas:0}],carteiraAtiva:{total:0,paginas:1,url:'https://www.idealista.pt/tools/publicacion/idealista?ScopeId=1',registos:[]}}),ranking=Object.assign({},base,{tipo:'ranking',fonte:'Excel oficial Idealista',registos:[{id:'0',ref:'TESTE',metricas:{contactos:0}}]}),lote={v:6,origem:'idealista',blocos:[{nome:'estatisticas',texto:'CLARA2:'+JSON.stringify(geral)},{nome:'ranking',texto:'CLARA2:'+JSON.stringify(ranking)}],faltas:[]},a=analisarConjunto_('CLARA6:'+JSON.stringify(lote)),r={blocos:a.quantidade,lacunas:a.lacunas.length,somenteLeitura:true,importacaoReal:false};console.log(JSON.stringify(r));return r;}
