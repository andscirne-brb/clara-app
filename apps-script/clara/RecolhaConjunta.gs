/* Lotes por portal: valida tudo antes de guardar; cada bloco mantém a sua transação e assinatura. */
function rcPreparar_(texto){
 const t=String(texto||'').trim();if(t.length>6000000||!t.startsWith('CLARA6:'))throw Error('Leitura conjunta inválida ou demasiado grande.');let d;try{d=JSON.parse(t.slice(7));}catch(e){throw Error('Leitura conjunta incompleta.');}
 if(!d||d.v!==6||!['green-acres','idealista'].includes(d.origem)||!Array.isArray(d.blocos)||!d.blocos.length||d.blocos.length>2||!Array.isArray(d.faltas)||d.faltas.length>2)throw Error('Estrutura da recolha conjunta inválida.');
 const ideal=d.origem==='idealista',permitidos=ideal?['estatisticas','ranking']:['estatisticas','anuncios'],prefixo=ideal?'CLARA2:':'CLARA4:';const nomes=new Set();d.blocos.forEach(b=>{if(!b||!permitidos.includes(b.nome)||nomes.has(b.nome)||typeof b.texto!=='string'||!b.texto.startsWith(prefixo))throw Error('Bloco repetido ou não permitido.');const x=JSON.parse(b.texto.slice(7));if(x.origem!==d.origem||x.v!==(ideal?2:4)||(ideal?x.tipo!==(b.nome==='ranking'?'ranking':'geral'):(b.nome==='anuncios')!==(x.tipo==='anuncios')))throw Error('O bloco não corresponde ao relatório identificado.');if(ideal&&b.nome==='ranking'&&x.fonte!=='Excel oficial Idealista')throw Error('O ranking conjunto exige o Excel oficial.');nomes.add(b.nome);});
 d.faltas.forEach(f=>{if(!f||!permitidos.includes(f.nome)||nomes.has(f.nome)||typeof f.erro!=='string'||!f.erro.trim()||f.erro.length>600)throw Error('Mapa de relatórios em falta inválido.');nomes.add(f.nome);});if(ideal&&d.blocos.length===2){const a=JSON.parse(d.blocos[0].texto.slice(7)),b=JSON.parse(d.blocos[1].texto.slice(7));if(!a.periodo||!b.periodo||a.periodo.inicio!==b.periodo.inicio||a.periodo.fim!==b.periodo.fim)throw Error('Os períodos dos relatórios Idealista não coincidem.');}if(nomes.size!==2)throw Error('A recolha não identifica todos os relatórios previstos.');return d;
}
function rcLacunas_(d){if(d.origem!=='idealista')return [];const b=d.blocos.find(x=>x.nome==='estatisticas');if(!b)return [];const x=JSON.parse(b.texto.slice(7));return [(!Array.isArray(x.diarios)||!x.diarios.length)?'Contactos diários por recolher. '+(x.avisoSerie||''):'',!x.carteiraAtiva?'Carteira ativa por recolher. '+(x.avisoCarteira||''):''].filter(Boolean);}
function analisarConjunto_(texto){const d=rcPreparar_(texto),itens=d.blocos.map(b=>({nome:b.nome,analise:analisar(b.texto,{})}));return{origem:d.origem,tipo:'conjunta',quantidade:itens.length,previstos:2,lacunas:rcLacunas_(d),itens,faltas:d.faltas,duplicada:itens.every(i=>i.analise.duplicada),aviso:'Relatórios com âmbitos e períodos próprios. Não são somados entre si. A gravação é conferida por bloco; em caso de falha os blocos já guardados são preservados.'};}
function gravarConjunto_(texto){const d=rcPreparar_(texto);analisarConjunto_(texto);const resultados=[];for(const b of d.blocos){try{resultados.push({nome:b.nome,resultado:gravar(b.texto,{})});}catch(e){return{origem:d.origem,tipo:'conjunta',parcial:true,resultados,erro:String(e.message||e).slice(0,600),falhou:b.nome,escritos:resultados.reduce((n,x)=>n+(x.resultado.escritos||0),0),automacaoPortais:resultados.some(x=>x.resultado.automacaoPortais)};}}
 return{origem:d.origem,tipo:'conjunta',quantidade:resultados.reduce((n,x)=>n+(x.resultado.quantidade||0),0),avisoSeguimento:d.faltas.length?'Dados disponíveis guardados. Falta recolher: '+d.faltas.map(f=>f.nome).join(', ')+'.':(rcLacunas_(d).length?'Dados guardados; há componentes por recolher.':'Recolha conjunta guardada; não precisas de repetir esta gravação.'),escritos:resultados.reduce((n,x)=>n+(x.resultado.escritos||0),0),duplicada:resultados.every(x=>x.resultado.duplicada),resultados,cobertura:resultados.length+' de 2 blocos previstos processados.'+(d.faltas.length?' Por recolher: '+d.faltas.map(f=>f.nome).join(', ')+'.':(rcLacunas_(d).length?' '+rcLacunas_(d).join(' '):' Recolha conjunta completa.')),automacaoPortais:resultados.some(x=>x.resultado.automacaoPortais)};
}

function verificarRecolhaConjunta(){const dia='2000-01-01',relatorios=['visitas','emails','listas','anuncios','mensal'].map(codigo=>({codigo,inicio:dia,fim:dia,faltamDias:0,linhas:[{data:dia,valores:['anuncios','mensal'].includes(codigo)?[0,0]:[0]}]})),estatisticas={v:4,origem:'green-acres',url:'https://back.green-acres.com/pt/Agent',conta:'0',sites:'all',lido:dia,relatorios},anuncios={v:4,origem:'green-acres',tipo:'anuncios',url:'https://back.green-acres.com/pt/Agent/Advert/List',lido:dia,total:1,paginas:1,periodo:'this_month',periodoNome:'Este mês',filtros:[],totais:[0,0,0,0],anuncios:[{ref:'0',url:'https://www.green-acres.pt/pt/properties/Aaaaa.htm',estado:'Teste sintético',difusao:'Teste',criado:dia,preco:1,cidade:'Teste',pais:'Teste',fotos:null,semPlanta:false,valores:[0,0,0,0]}]},d={v:6,origem:'green-acres',blocos:[{nome:'estatisticas',texto:'CLARA4:'+JSON.stringify(estatisticas)},{nome:'anuncios',texto:'CLARA4:'+JSON.stringify(anuncios)}],faltas:[]},a=analisarConjunto_('CLARA6:'+JSON.stringify(d)),r={blocosValidados:a.quantidade,csvsValidados:a.itens[0].analise.quantidade,anunciosSinteticos:a.itens[1].analise.quantidade,somenteLeitura:true,importacaoReal:false};console.log(JSON.stringify(r));return r;}

