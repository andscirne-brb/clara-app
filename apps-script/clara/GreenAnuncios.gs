function gravarAnunciosGreenDados_(texto,ss){
 const inicio=Date.now(),p=prepararAnunciosGreen_(texto,ss),preparacaoMs=Date.now()-inicio;if(p.duplicada)return{origem:'green-acres',duplicada:true,escritos:0,tempos:{preparacaoMs,escritaConferenciaMs:0,dashboardMs:0}};
