/* Avisos descritivos para revisão, sem pontuação, metas inventadas ou escritas. */
function adNum_(v){return typeof v==='number'&&isFinite(v)&&v>=0?v:null;}
function adDia_(s){if(typeof s!=='string'||!/^20\d\d-\d\d-\d\d$/.test(s))return null;const t=Date.parse(s+'T00:00:00Z');return Number.isFinite(t)&&new Date(t).toISOString().slice(0,10)===s?t/86400000:null;}
function adComparar_(atual,anterior){const a=adDia_(atual.inicio),b=adDia_(atual.fim),c=adDia_(anterior.inicio),d=adDia_(anterior.fim);if([a,b,c,d].some(v=>v===null)||b<a||d<c||b-a!==d-c||d+1!==a||atual.filtros!==anterior.filtros)return[];const avisos=[];['visitas','contactos'].forEach(k=>{const n=adNum_(atual[k]),p=adNum_(anterior[k]);if(n!==null&&p!==null&&p>0&&n<p)avisos.push((k==='visitas'?'Menos visitas':'Menos contactos')+': '+p+' → '+n+' ('+Math.round((n/p-1)*100)+'%). Períodos consecutivos com '+(b-a+1)+' dias e os mesmos filtros.');});return avisos;}
function adIdealista_(id,rows){
 const rs=rows.filter(r=>r[1]==='ranking'&&String(r[6])===id&&adDia_(String(r[0]))!==null),grupos={};
 rs.forEach(r=>{const k=JSON.stringify([r[0],r[2],r[3],r[4],r[10]]);const g=grupos[k]||(grupos[k]={data:String(r[0]),inicio:String(r[2]),fim:String(r[3]),filtros:String(r[4]),metricas:{},conflito:false});if(g.metricas[r[7]]!==undefined&&g.metricas[r[7]]!==r[8])g.conflito=true;g.metricas[r[7]]=r[8];});
 const gs=Object.values(grupos).filter(g=>!g.conflito&&adDia_(g.inicio)!==null&&adDia_(g.fim)!==null&&adDia_(g.fim)>=adDia_(g.inicio)&&g.fim<=g.data).map(g=>{const m=g.metricas;g.visitas=adNum_(m.visitasDetalhes);g.contactos=adNum_(m.contactos);if(g.contactos===null&&adNum_(m.chamadas)!==null&&adNum_(m.mensagens)!==null)g.contactos=m.chamadas+m.mensagens;return g;}).sort((a,b)=>b.fim.localeCompare(a.fim)||b.data.localeCompare(a.data));
 if(!gs.length)return{avisos:[],nota:'Faltam métricas de ranking com período explícito.',fonte:'Ranking Idealista'};
 const g=gs[0],mesmo=gs.filter(x=>x.fim===g.fim&&x.data===g.data);if(new Set(mesmo.map(x=>JSON.stringify([x.inicio,x.filtros,x.visitas,x.contactos]))).size>1)return{avisos:[],nota:'Recolhas mais recentes com filtros ou valores distintos; rever antes de comparar.',fonte:'Ranking Idealista'};
 const avisos=[],dias=adDia_(g.fim)-adDia_(g.inicio)+1;if(dias>=7&&g.visitas>0&&g.contactos===0)avisos.push('Visitas sem contactos registados: '+g.visitas+' visitas em detalhes e 0 contactos no período. Rever o anúncio e a qualidade da medição.');
 const anteriores=gs.filter(x=>adDia_(x.fim)+1===adDia_(g.inicio)&&x.filtros===g.filtros&&adDia_(x.fim)-adDia_(x.inicio)===dias-1),p=anteriores[0];if(p){const ult=anteriores.filter(x=>x.data===p.data);if(new Set(ult.map(x=>JSON.stringify([x.visitas,x.contactos]))).size===1)avisos.push(...adComparar_(g,p));}
 return{avisos,nota:(!p?'Sem período anterior consecutivo equivalente. ':'')+(g.contactos===null?'Contactos desconhecidos; não tratados como zero.':''),fonte:'Ranking Idealista',data:g.data,periodo:g.inicio+' a '+g.fim,evidencia:'Visitas em detalhes: '+(g.visitas===null?'por confirmar':g.visitas)+' · Contactos: '+(g.contactos===null?'por confirmar':g.contactos)};
}
function adGreen_(id,rows){const rs=rows.filter(r=>String(r[3])===id&&adDia_(String(r[0]))!==null).sort((a,b)=>String(b[0]).localeCompare(String(a[0])));if(!rs.length)return{avisos:[],nota:'Sem métricas por anúncio associadas.',fonte:'Lista oficial Green-Acres'};const r=rs[0],ult=rs.filter(x=>x[0]===r[0]);if(new Set(ult.map(x=>JSON.stringify([x[1],x[2],x[14],x[15]]))).size>1)return{avisos:[],nota:'Vários filtros ou valores na mesma data; comparação bloqueada.',fonte:'Lista oficial Green-Acres'};const fechado=/^(último mês|mês passado|mês anterior|last month)$/i.test(String(r[1]).trim()),visitas=adNum_(r[14]),emails=adNum_(r[15]),avisos=[];if(fechado&&visitas>0&&emails===0)avisos.push('Visitas sem emails registados no mês anterior: '+visitas+' visitas e 0 emails. Não inclui outros canais de contacto.');return{avisos,fonte:'Lista oficial Green-Acres',data:String(r[0]),periodo:String(r[1]),evidencia:'Visitas: '+(visitas===null?'por confirmar':visitas)+' · Emails: '+(emails===null?'por confirmar':emails),nota:fechado?'Sem comparação entre meses de duração diferente.':'Período parcial ou sem datas absolutas: não gera alerta de falta de resposta nem comparação temporal.'};}
function adRightmove_(id,rows){const rs=rows.filter(r=>String(r[3])===id&&Number(r[2])===30&&adDia_(String(r[0]))!==null).sort((a,b)=>String(b[0]).localeCompare(String(a[0])));if(!rs.length)return{avisos:[],nota:'Falta relatório por anúncio com janela de 30 dias.',fonte:'Property Performance Rightmove'};const r=rs[0],ult=rs.filter(x=>x[0]===r[0]);if(new Set(ult.map(x=>JSON.stringify([x[1],x[10],x[11]]))).size>1)return{avisos:[],nota:'Valores distintos na mesma data; rever antes de comparar.',fonte:'Property Performance Rightmove'};const raw=String(r[11]||''),m=raw.trim().match(/^([+-]?\d+(?:\.\d+)?)\s*·\s*([+-]?\d+(?:\.\d+)?)%?$/),avisos=[];if(m&&Number(m[1])<0&&Number(m[2])<0)avisos.push('Menos visitas diárias médias face aos 30 dias anteriores, segundo o portal: '+m[2]+'%. Confirmar o contexto antes de agir.');return{avisos,fonte:'Property Performance Rightmove',data:String(r[0]),periodo:'30 dias · Dados até '+String(r[1]||'por confirmar'),evidencia:'Visitas diárias médias: '+(adNum_(r[10])===null?'por confirmar':r[10])+' · Comparação anterior: '+(raw||'por confirmar'),nota:'Sem contactos por imóvel nesta fonte; não se infere falta de leads. '+(!m?'Comparação anterior não normalizada; não gera alerta automático.':'')};}
function adModelo_(x,ligacoes,fontes){if(x.duplicada)return[];return ligacoes.filter(l=>['Idealista','Green-Acres','Rightmove'].includes(l[0])&&String(l[3]||'').trim().toUpperCase()===x.ref&&l[4]==='Confirmada').map(l=>{const p=l[0],id=String(l[1]),r=p==='Idealista'?adIdealista_(id,fontes.idealista||[]):p==='Green-Acres'?adGreen_(id,fontes.green||[]):adRightmove_(id,fontes.rightmove||[]);return{portal:p,id,...r};});}
function verificarAlertasPrioritarios(){const m=consultarAuditoriaPrioritarios(),itens=m.imoveis.flatMap(x=>x.alertas||[]),r={prioritarios:m.quantidade,anunciosAvaliados:itens.length,avisos:itens.reduce((n,x)=>n+x.avisos.length,0),somenteLeitura:true,pendenciasCriadas:0};console.log(JSON.stringify(r));return r;}
