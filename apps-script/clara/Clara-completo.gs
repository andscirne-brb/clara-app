const PORTAIS_HTML = "<!doctype html><html lang=\"pt\"><head><meta charset=\"utf-8\"><base target=\"_top\"><style>\nbody{font:14px/1.5 Arial,sans-serif;color:#183746;background:#f3f7f9;margin:0;padding:16px}h1{font-size:20px}h2{font-size:16px;margin:0 0 8px}p{margin:8px 0}.card{background:white;border:1px solid #d9e3e9;border-radius:9px;padding:12px;margin:12px 0}.muted{font-size:12px;color:#526b78}.notice{padding:10px;background:#fff4db;border-left:3px solid #b57a11}input{width:100%;box-sizing:border-box;padding:10px;border:1px solid #91a8b4;border-radius:6px}button{border:0;border-radius:6px;background:#087f8c;color:white;padding:10px;margin:6px 4px 6px 0;cursor:pointer}button:disabled{opacity:.55;cursor:wait}button.sec{background:white;color:#087f8c;border:1px solid #a9bdc6}a{color:#087f8c}label{font-weight:bold}button:focus-visible,input:focus{outline:3px solid #79c5d3;outline-offset:2px}dl{margin:6px 0}dt{font-size:12px;color:#526b78}dd{margin:0 0 8px;font-weight:bold}[hidden]{display:none!important}\n</style></head><body><h1>Ficha por imóvel</h1><p class=\"muted\">Estado eGO e resultados dos três portais, pela referência original.</p><section class=\"card\"><label for=\"ref\">Referência eGO</label><input id=\"ref\" placeholder=\"Ex.: APT14077\" maxlength=\"40\"><button id=\"consultar\" onclick=\"consultar()\">Consultar imóvel</button></section><div id=\"status\" role=\"status\" aria-live=\"polite\"></div><button id=\"parar\" class=\"sec\" hidden onclick=\"continuar=false;this.disabled=true;estado('A terminar e guardar o lote atual…')\">Parar após este lote</button><div id=\"ficha\"></div><details class=\"card\"><summary>Atualizar as ligações dos portais</summary><p class=\"muted\">Usa as recolhas já guardadas. Uma referência em falta fica por rever; não significa que o imóvel não esteja publicado.</p><button onclick=\"atualizar()\">Atualizar a partir das recolhas</button><button class=\"sec\" onclick=\"identificar()\">Identificar anúncios</button><p class=\"muted\">A identificação consulta apenas fichas públicas. Guarda cada lote e retoma sem repetir fichas já identificadas ou com problemas de acesso.</p><button class=\"sec\" onclick=\"google.script.run.irPara('Ligações dos portais',2)\">Ver ligações e casos por rever</button><button class=\"sec\" onclick=\"google.script.run.irPara('Imóveis nos portais',2)\">Ver todos os imóveis</button></details><button class=\"sec\" onclick=\"google.script.run.abrirLista()\">Voltar ao progresso</button><script>\nfunction esc(x){return String(x==null?'':x).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));}let busy=false,consulta=0,continuar=false;\nfunction estado(t){document.getElementById('status').textContent=t;}\nfunction bloquear(b){busy=b;document.querySelectorAll('button').forEach(x=>x.disabled=b);document.getElementById('ref').disabled=b;}\nfunction falha(e){continuar=false;document.getElementById('parar').hidden=true;bloquear(false);estado(/PERMISSION_DENIED|authorization|autoriza/i.test(e.message||'')?'O Google exige autorização para esta funcionalidade. Abre o documento com a tua conta e revê as autorizações da Clara.':e.message||'Não foi possível concluir.');}\nfunction consultar(){if(busy)return;const ref=document.getElementById('ref').value.trim(),seq=++consulta;if(!ref){estado('Indica uma referência eGO.');return;}bloquear(true);estado('A consultar o imóvel…');google.script.run.withSuccessHandler(d=>{if(seq!==consulta)return;bloquear(false);estado('');if(d.erro){document.getElementById('ficha').innerHTML='<p class=\"notice\">'+esc(d.erro)+'</p>';return;}let h='<section class=\"card\"><h2>'+esc(d.ref)+'</h2><p>'+esc(d.natureza)+' · '+esc(d.concelho)+'</p><p>eGO: '+esc(d.estado||'Por verificar')+'</p>'+(d.faltas?'<p class=\"notice\">'+esc(d.faltas)+'</p>':'')+'<button class=\"sec\" onclick=\"google.script.run.irPara(\\'Levantamento\\','+Number(d.linha)+')\">Ver no levantamento</button></section>';\n ['Idealista','Green-Acres','Rightmove'].forEach(p=>{const entries=d.portais.filter(x=>x.portal===p);if(!entries.length){h+='<section class=\"card\"><h2>'+p+'</h2><p class=\"muted\">Sem ligação confirmada. Publicação por verificar.</p></section>';return;}entries.forEach(x=>{h+='<section class=\"card\"><h2>'+p+'</h2><p>'+esc(x.estado)+'</p>';if(x.dados){const m=x.dados;h+='<p class=\"muted\">'+esc(m.periodo)+'<br>Recolhido em '+esc(m.recolha||'por confirmar')+'</p><dl>'+(m.metricas||[]).map(y=>'<dt>'+esc(y.nome)+'</dt><dd>'+esc(y.valor)+'</dd>').join('')+'</dl>'+(m.preco!==undefined?'<p>Preço: '+esc(m.preco)+' €</p>':'')+(m.fotos!==undefined?'<p>Fotografias: '+esc(m.fotos===''?'Por confirmar':m.fotos)+'</p>':'')+(m.planta?'<p>'+esc(m.planta)+'</p>':'')+'<p class=\"muted\">'+esc(m.aviso||'')+'</p>';}h+='<p class=\"muted\">'+esc(x.fonte)+' · '+esc(x.data)+'</p>'+(x.nota?'<p class=\"notice\">'+esc(x.nota)+'</p>':'')+(/^https:\\/\\/(?:www\\.)?(?:idealista\\.pt|green-acres\\.pt|rightmove\\.co\\.uk)\\//.test(x.url)?'<a rel=\"noopener\" target=\"_blank\" href=\"'+esc(x.url)+'\">Abrir anúncio</a>':'')+'</section>';});});document.getElementById('ficha').innerHTML=h+'<p class=\"notice muted\">'+esc(d.aviso)+'</p>';}).withFailureHandler(falha).fichaImovelPortais(ref);}\n function atualizar(){if(busy)return;bloquear(true);estado('A conferir as recolhas e as referências…');google.script.run.withSuccessHandler(r=>{bloquear(false);estado(r.confirmadas+' ligações confirmadas · '+r.porRever+' por rever. '+r.alteradas+' alterações registadas.');}).withFailureHandler(falha).atualizarImoveisPortais();}\n function identificar(){if(busy)return;continuar=true;bloquear(true);document.getElementById('parar').hidden=false;document.getElementById('parar').disabled=false;lote();}\n function lote(){estado('A identificar anúncios em lotes de cinco. Cada lote fica guardado.');google.script.run.withSuccessHandler(r=>{estado(r.mensagem+(r.restantes!==undefined?' Restam '+r.restantes+' fichas novas.':''));if(continuar&&r.restantes>0&&r.processados>0){lote();return;}continuar=false;document.getElementById('parar').hidden=true;bloquear(false);}).withFailureHandler(falha).identificarProximosImoveisPortais();}\n document.getElementById('ref').addEventListener('keydown',e=>{if(e.key==='Enter')consultar();});\natualizar();\n</script></body></html>\n";
