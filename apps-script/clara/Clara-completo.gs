iv class=\"warning\">Carteira ativa por recolher. '+esc(a.avisoCarteira||'Esta leitura contém apenas as estatísticas.')+'</div>';\n h+='</section>';if(a.duplicada){h+='<div class=\"success\">Esta recolha já está guardada. Não será duplicada.</div>';preview=null;mensagem('Podes colar a próxima leitura.');}else h+='<p class=\"muted\">Destino: Idealista - recolhas. Períodos diferentes não são somados.</p>';\n }else{const mudam=a.campos.filter(c=>String(c.atual)!==String(c.novo)),iguais=a.campos.filter(c=>String(c.atual)===String(c.novo)),novas=a.pendencias.filter(p=>!p.jaExiste),ja=a.pendencias.filter(p=>p.jaExiste&&!p.reabrir),reabertas=a.pendencias.filter(p=>p.reabrir);h='<h2>'+esc(a.ref)+'</h2><div class=\"summary\"><div><b>'+mudam.length+'</b>alterações</div><div><b>'+novas.length+'</b>pendências novas</div><div><b>'+(a.naoVerificados||a.campos.filter(c=>c.novo==='Por verificar')).length+'</b>por verificar</div></div>';\n if(!a.completa)h+='<div class=\"warning\"><b>Leitura parcial.</b> O imóvel fica «Em curso». Os campos não lidos não são reconfirmados. A informação anterior é preservada.</div>';\n if(a.naoVerificados&&a.naoVerificados.length)h+='<details open><summary>Não verificados nesta leitura ('+a.naoVerificados.length+')</summary><div class=\"muted\">'+a.naoVerificados.map(x=>esc(x.coluna)+(x.preservado?' · mantido: '+esc(x.anterior):' · por verificar')).join('<br>')+'</div></details>';\n h+='<details open><summary>Alterações a guardar ('+mudam.length+')</summary>'+tabela(mudam)+'</details>';if(iguais.length)h+='<details><summary>Campos sem alteração ('+iguais.length+')</summary>'+tabela(iguais)+'</details>';\n if(a.cruzamento){const x=a.cruzamento;h+='<details open><summary>Características · '+esc(x.estado)+'</summary><div class=\"muted\">'+(x.avaliadas?'Comparação de '+x.avaliadas+' tipos de características. Sugestões para confirmar no eGO; não prova existência física.':'Faltam nomes das características ou descrição PT nesta leitura. Atualiza o marcador se necessário.')+'</div>'+x.sugestoes.map(y=>'<div class=\"p\"><b>'+esc(y.nome)+' · mencionada mas não assinalada</b><div class=\"muted\">'+esc(y.excerto)+'</div></div>').join('')+(x.assinaladasSemTexto.length?'<div class=\"muted\">Assinaladas sem menção afirmativa detetada na descrição PT: '+x.assinaladasSemTexto.map(esc).join(', ')+'.</div>':'')+'</details>';}\n if(novas.length)h+='<h3>Pendências novas</h3>'+novas.map(p=>'<div class=\"p '+(p.sara?'sara':'')+'\"><b>'+esc(p.assunto)+'</b><div class=\"muted\">'+esc(p.acao)+'</div></div>').join('');\n if(reabertas.length)h+='<div class=\"warning\">Serão reabertas: '+reabertas.map(p=>esc(p.jaExiste+' · '+p.assunto)).join('; ')+'. A resolução anterior fica no histórico.</div>';\n if(a.resolvidas&&a.resolvidas.length)h+='<div class=\"success\">Correções confirmadas: '+a.resolvidas.map(r=>esc(r.id+' · '+r.assunto)).join('; ')+'.</div>';\n if(ja.length)h+='<details><summary>Pendências já registadas ('+ja.length+')</summary><div class=\"muted\">'+ja.map(p=>esc(p.jaExiste+' · '+p.assunto)+(p.atualizar?'<br><strong>Atualizar:</strong> '+esc(p.evidencia):'')).join('<br>')+'</div></details>';\n if(a.notas&&a.notas.length)h+='<details><summary>Notas da leitura</summary><div class=\"muted\">'+a.notas.map(esc).join('<br>')+'</div></details>';h+='<p class=\"muted\">Destino: Levantamento, textos por idioma e histórico de alterações.</p>';\n }if(a.conferencia)h+='<section class=\"box\"><h2>'+esc(a.conferencia.estado)+'</h2>'+a.conferencia.avisos.map(x=>'<p class=\"warning\">'+esc(x)+'</p>').join('')+a.conferencia.notas.map(x=>'<p class=\"muted\">'+esc(x)+'</p>').join('')+'</section>';el('res').innerHTML=h;controles();}\nlet automacaoEmCurso=false,automacaoReiniciar=false;\nfunction iniciarAutomacaoPortais(){if(automacaoEmCurso){automacaoReiniciar=true;return;}automacaoEmCurso=true;loteAutomacaoPortais(true);}\nfunction loteAutomacaoPortais(iniciar){const box=el('automacao');box.hidden=false;box.textContent='Recolha guardada. A identificar novos anúncios em lotes de cinco…';google.script.run.withSuccessHandler(r=>{box.textContent=r.confirmadas+' ligações confirmadas · '+r.porRever+' por rever · '+r.restantes+' por identificar.';if(r.restantes>0&&r.processados>0){loteAutomacaoPortais(false);return;}if(automacaoReiniciar){automacaoReiniciar=false;loteAutomacaoPortais(true);return;}automacaoEmCurso=false;box.textContent+=' Consulta os casos por rever em Clara > Portais: conferência.';}).withFailureHandler(e=>{automacaoEmCurso=false;automacaoReiniciar=false;box.textContent='Os dados ficaram guardados. Identificação pendente: '+(e.message||'Não foi possível concluir')+'. Retoma em Clara > Portais: identificar anúncios. Não repitas a importação.';}).continuarAutomacaoPortais(iniciar);}\nfunction gravar(){if(ocupado||!preview)return;if(preview.texto!==el('txt').value||JSON.stringify(preview.docs)!==JSON.stringify(docs())){invalidar('A leitura mudou. Volta a analisar antes de guardar.');return;}const p=preview,inicioGravacao=Date.now();guardarRascunho(true);ocupado=true;etapa(3);mensagem('A guardar no Sheets… Mantém este painel aberto.');el('erro').hidden=true;controles();google.script.run.withSuccessHandler(r=>{ocupado=false;preview=null;if(r.parcial){el('res').innerHTML='<div class=\"warning\"><h2>Gravação não concluída</h2><p>'+esc(r.resultados.length)+' blocos processados. A leitura foi mantida.</p><p>'+esc(r.falhou)+': '+esc(r.erro)+'</p><p>Volta a analisar. Os blocos já guardados serão reconhecidos e não serão duplicados.</p></div>';mensagem('A gravação foi interrompida; confirma o que ficou guardado antes de repetir.');etapa(1);guardarRascunho(true);controles();if(r.automacaoPortais)iniciarAutomacaoPortais();return;}ultimoRegisto=['idealista','rightmove','green-acres'].includes(r.origem)?null:{linha:p.a.linha};el('res').innerHTML='<div class=\"success\"><h2>Guardado no Sheets</h2><p class=\"muted\">Gravação: '+Math.max(1,Math.round((Date.now()-inicioGravacao)/1000))+' s.</p>'+(r.tempos?'<p class=\"muted\">Guardar e conferir dados: '+((r.tempos.preparacaoMs+r.tempos.escritaConferenciaMs)/1000).toFixed(1)+' s · Dashboard: '+(r.tempos.dashboardMs/1000).toFixed(1)+' s'+(r.dashboardReutilizado?' (sem alterações)':'')+'.</p>':'')+(['idealista','rightmove','green-acres'].includes(r.origem)?'<p>'+esc(r.duplicada?'Esta recolha já estava guardada.':['rightmove','green-acres'].includes(r.origem)?r.escritos+' linhas registadas.':r.quantidade+' registos · '+r.escritos+' indicadores.')+'</p><p>'+esc(r.cobertura||'')+'</p>':'<p><b>'+esc(r.ref)+'</b> · '+r.escritos+' campos atualizados.</p><p>'+r.textos+' idiomas registados · '+r.historico+' alterações no histórico.</p>')+'</div>'+(ultimoRegisto?'<button class=\"sec\" onclick=\"verRegisto()\">Ver no Levantamento</button>':'');el('txt').value='';limparDocs();ultimaOrigem=null;guardarRascunho();verificarVersao();el('origem').textContent='Leitura guardada. Podes colar a próxima.';mensagem(r.avisoSeguimento||'Concluído. Não precisas de repetir esta gravação.');controles();if(r.automacaoPortais)iniciarAutomacaoPortais();}).withFailureHandler(falhou).gravar(p.texto,p.docs);}\nfunction verRegisto(){if(ultimoRegisto)google.script.run.irPara('Levantamento',ultimoRegisto.linha);}\naplicarMarca('__CLARA_MARCA__');recuperarRascunho();controles();\n</script></body></html>\n";
const ESTADO_DOCUMENTAL_HTML = "<!doctype html><html lang=\"pt\"><head><base target=\"_top\"><meta charset=\"utf-8\"><style>\nbody{font:13px/1.5 Arial;color:#183746;background:#f3f6fa;padding:12px}h1{font-size:19px}label{display:block;margin:12px 0 4px}input,select,button{box-sizing:border-box;width:100%;padding:10px;border:1px solid #a9bdc8;border-radius:6px}button{background:#087f8c;color:white;margin-top:12px;cursor:pointer}button:disabled{opacity:.5;cursor:wait}.box{background:white;padding:12px;border-radius:9px;margin:12px 0}.muted{font-size:12px;color:#526b78}#msg{white-space:pre-line}a{color:#087f8c}[hidden]{display:none}</style></head><body>\n<h1>eGO: estado</h1><p>Atualizar documentos e planta por referência.</p><p class=\"muted\">Regista no Sheets o trabalho que fizeste. Não altera o eGO.</p>\n<label for=\"ref\">Referência do imóvel</label><input id=\"ref\" placeholder=\"Ex.: MI14372\" autocomplete=\"off\"><button id=\"buscar\" onclick=\"buscar()\">Pesquisar</button>\n<p id=\"msg\" role=\"status\" aria-live=\"polite\"></p><section id=\"form\" class=\"box\" hidden><h2 id=\"imovel\"></h2><label for=\"website\">Visibilidade no website da agência</label><select id=\"website\"></select><p class=\"muted\">Confirmação manual. Não altera a disponibilidade no eGO nem a publicação nos portais.</p><button id=\"guardarWebsite\" onclick=\"guardarWebsite()\">Guardar visibilidade do website</button><hr><div id=\"campos\"></div><label for=\"confirmar\"><input style=\"width:auto\" type=\"checkbox\" id=\"confirmar\"> Confirmo os estados escolhidos</label><button id=\"guardar\" onclick=\"guardar()\">Guardar alterações</button></section>\n<button onclick=\"google.script.run.abrirPainel()\">Voltar à leitura do marcador</button>\n<script>\nconst $=id=>document.getElementById(id);let snapshot=null,busy=false;\nconst esc=v=>String(v).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nfunction bloquear(v){busy=v;$('buscar').disabled=v;$('guardar').disabled=v;$('guardarWebsite').disabled=v;$('ref').disabled=v;document.querySelectorAll('select').forEach(s=>s.disabled=v);}\nfunction falha(e){bloquear(false);$('msg').textContent=e.message||String(e);}\nfunction buscar(){if(busy)return;snapshot=null;$('form').hidden=true;bloquear(true);$('msg').textContent='A procurar…';google.script.run.withSuccessHandler(s=>{snapshot=s;$('imovel').textContent=s.ref;$('website').innerHTML=s.opcoesWebsite.map(o=>'<option'+(o===s.website?' selected':'')+'>'+esc(o)+'</option>').join('');$('campos').innerHTML=s.campos.map(c=>'<label for=\"ed_'+c.id+'\">'+esc(c.nome)+'</label><select id=\"ed_'+c.id+'\">'+s.opcoes.map(o=>'<option value=\"'+esc(o)+'\"'+(o===s.estados[c.id]?' selected':'')+'>'+esc(o==='Não aplicável'?'N/A':o)+'</option>').join('')+'</select>').join('');$('confirmar').checked=false;$('form').hidden=false;$('msg').textContent='Digitalizado: falta preparar e inserir no eGO. Ausente também no dossier: encaminhado para Sara.';bloquear(false);}).withFailureHandler(falha).pesquisarEstadoDocumental($('ref').value);}\nfunction guardar(){if(busy||!snapshot)return;if(!$('confirmar').checked){$('msg').textContent='Confirma os estados antes de guardar.';return;}const estados={};snapshot.campos.forEach(c=>estados[c.id]=$('ed_'+c.id).value);bloquear(true);$('msg').textContent='A guardar e sincronizar…';google.script.run.withSuccessHandler(r=>{snapshot=null;$('form').hidden=true;bloquear(false);$('msg').textContent=r.ref+': guardado. Levantamento, pendências e resumo atualizados.';}).withFailureHandler(falha).guardarEstadoDocumental(snapshot.ref,estados,snapshot.assinatura);}\nfunction guardarWebsite(){if(busy||!snapshot)return;const ref=snapshot.ref;bloquear(true);$('msg').textContent='A guardar a visibilidade…';google.script.run.withSuccessHandler(r=>{snapshot=null;$('form').hidden=true;bloquear(false);$('msg').textContent=ref+': visibilidade guardada no levantamento e no histórico. Pesquisa novamente para editar outros campos.';}).withFailureHandler(falha).guardarVisibilidadeWebsite(ref,$('website').value,snapshot.assinatura);}\n$('ref').addEventListener('input',()=>{snapshot=null;$('form').hidden=true;});\n</script></body></html>\n";
const AUDITORIA_PRIORITARIOS_HTML = "<!doctype html><html lang=\"pt\"><head><meta charset=\"utf-8\"><base target=\"_blank\"><style>\nbody{font:14px Arial,sans-serif;color:#183746;margin:20px;background:#f3f6fa}h1{font-size:23px;margin-bottom:8px}h2{font-size:18px}.muted{color:#526b78;line-height:1.5}.cards{display:flex;gap:12px;margin:18px 0}.card{background:white;border:1px solid #dce5e9;padding:14px;border-radius:8px;flex:1}.number{font-size:28px;font-weight:bold;display:block;margin-bottom:6px}button,select{font:inherit;padding:10px;border-radius:5px;border:1px solid #b8ccd5;background:white;color:#183746}button{cursor:pointer;background:#087f8c;color:white}button:disabled{opacity:.55;cursor:wait}.toolbar{display:flex;align-items:center;gap:12px}table{border-collapse:collapse;width:100%;background:white;margin:12px 0}th,td{text-align:left;border-bottom:1px solid #dce5e9;padding:10px;vertical-align:top}th{background:#183746;color:white}.acao{color:#895000}.desconhecido{color:#526b78}.registado{color:#156c4b}.warning{background:#fff5df;border-left:3px solid #d29428;padding:12px;line-height:1.5}a{color:#087f8c}summary{cursor:pointer}#error{color:#a12424}option{color:#183746}\n</style></head><body><h1>Auditoria dos imóveis prioritários</h1><p class=\"muted\">Últimos estados registados · consulta sem alterações ao levantamento ou às pendências.</p><div class=\"toolbar\"><button id=\"refresh\" onclick=\"carregar()\">Atualizar consulta</button><span id=\"time\" class=\"muted\" role=\"status\" aria-live=\"polite\"></span></div><p id=\"error\" role=\"alert\"></p><div id=\"content\" hidden><div class=\"cards\" id=\"cards\"></div><label for=\"ref\">Consultar imóvel</label> <select id=\"ref\" onchange=\"mostrar()\"></select><section id=\"detail\"></section><details><summary>O que esta auditoria ainda não verifica</summary><ul id=\"limits\"></ul></details><details><summary>Visão dos prioritários</summary><div id=\"overview\"></div></details></div><script>\nlet modelo;const el=id=>document.getElementById(id),esc=s=>String(s==null?'':s).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nfunction carregar(){const old=el('ref').value;el('refresh').disabled=true;el('error').textContent='';el('time').textContent='A consultar o levantamento…';google.script.run.withSuccessHandler(m=>renderizar(m,old)).withFailureHandler(e=>{el('refresh').disabled=false;el('time').textContent='Consulta não atualizada';el('content').hidden=true;el('error').textContent=e.message||String(e);}).consultarAuditoriaPrioritarios();}\nfunction renderizar(m,old){modelo=m;el('refresh').disabled=false;el('content').hidden=false;el('time').textContent='Consulta: '+m.atualizado;el('ref').innerHTML=m.imoveis.map(x=>'<option value=\"'+esc(x.ref)+'\">'+esc(x.ref+' · '+x.concelho)+'</option>').join('');if(m.imoveis.some(x=>x.ref===old))el('ref').value=old;const a=m.imoveis.filter(x=>x.contagens.acoes).length,d=m.imoveis.filter(x=>x.contagens.desconhecidos||x.duplicada).length;el('cards').innerHTML=[[m.quantidade,'Imóveis prioritários'],[a,'Com ações registadas'],[d,'Com campos por verificar'],[m.imoveis.filter(x=>(x.alertas||[]).some(a=>a.avisos.length)).length,'Com avisos de desempenho']].map(x=>'<div class=\"card\"><span class=\"number\">'+x[0]+'</span>'+esc(x[1])+'</div>').join('');el('limits').innerHTML=m.limites.map(x=>'<li>'+esc(x)+'</li>').join('');el('overview').innerHTML='<table><thead><tr><th>Referência</th><th>Estado registado</th><th>Ações</th><th>Por verificar</th><th>Avisos de desempenho</th></tr></thead><tbody>'+m.imoveis.map(x=>'<tr><td>'+esc(x.ref)+'</td><td>'+esc(x.estado)+'</td><td>'+x.contagens.acoes+'</td><td>'+x.contagens.desconhecidos+'</td><td>'+(x.alertas||[]).reduce((n,a)=>n+a.avisos.length,0)+'</td></tr>').join('')+'</tbody></table>';mostrar();}\nfunction comparacaoHtml(c){if(!c)return '';const preco=v=>typeof v==='number'?v.toLocaleString('pt-PT',{style:'currency',currency:'EUR'}):'Por confirmar';return '<h2>Preços · comparação com a base eGO</h2><p class=\"muted\">Exportação eGO: '+esc(c.dataEgo||'data por confirmar')+' · '+esc(c.estadoBase)+'</p><p class=\"muted\">'+esc(c.fonteEgo)+'</p><p>Natureza eGO: '+esc(c.natureza||'Por confirmar')+' · Concelho eGO: '+esc(c.concelho||'Por confirmar')+'</p><p>'+c.precos.map(p=>esc(p.operacao)+': '+esc(preco(p.valor))).join(' · ')+'</p><table><thead><tr><th>Portal / anúncio</th><th>Preço recolhido</th><th>Data da recolha</th><th>Conferência</th></tr></thead><tbody>'+c.portais.map(p=>'<tr><td>'+esc(p.portal)+(p.id?' · '+esc(p.id):'')+'</td><td>'+esc(preco(p.preco))+'</td><td>'+esc(p.recolha||'Sem recolha')+(p.dadosAte?'<br>Dados até '+esc(p.dadosAte):'')+'</td><td>'+esc(p.estado)+(p.diferenca!==null&&p.diferenca!==undefined?'<br>Diferença nominal: '+esc(preco(p.diferenca)):'')+'<br><small>'+esc(p.fonte||'')+'</small></td></tr>').join('')+'</tbody></table><p class=\"warning\">Não é uma confirmação de erro de preço. Verificar no eGO atual e confirmar a mesma operação antes de corrigir. Esta consulta não altera anúncios nem cria pendências.</p><p class=\"muted\">'+esc(c.limites)+'</p>';}\nfunction presencaHtml(lista){if(!lista)return '';return '<h2>Presença observada nos portais</h2><p class=\"muted\">Fontes já recolhidas, associadas por referência e ID confirmados. A data refere-se à recolha, não a uma nova visita ao anúncio.</p><table><thead><tr><th>Portal / anúncio</th><th>Observação</th><th>Recolha / fonte / âmbito</th></tr></thead><tbody>'+lista.flatMap(p=>p.anuncios.length?p.anuncios.map(a=>'<tr><td>'+esc(p.portal)+' · '+esc(a.id)+'</td><td>'+esc(a.estado)+'</td><td>'+esc(a.data||'Sem data de observação')+'<br>'+esc(a.fonte)+'<details><summary>Ver âmbito da recolha</summary><small>'+esc(a.ambito)+'</small></details></td></tr>'):['<tr><td>'+esc(p.portal)+'</td><td>'+esc(p.estado)+'</td><td>'+esc(p.fonte)+'</td></tr>']).join('')+'</tbody></table><p class=\"warning\">Não encontrar uma ligação ou um anúncio numa recolha filtrada não confirma ausência no portal. A presença atual exige uma recolha atual e de âmbito adequado; não são criadas pendências automaticamente.</p>';}\nfunction alertasHtml(lista){if(!lista)return '';return '<h2>Desempenho · avisos para revisão</h2><p class=\"muted\">Comparações dentro de cada portal e anúncio; não compara definições de visitas ou contactos entre portais. Sem criação automática de pendências.</p>'+(lista.length?'<table><thead><tr><th>Portal / anúncio</th><th>Aviso e contexto</th><th>Fonte / período</th></tr></thead><tbody>'+lista.map(a=>'<tr><td>'+esc(a.portal)+' · '+esc(a.id)+'</td><td>'+(a.avisos.length?a.avisos.map(v=>'<p class=\"acao\">'+esc(v)+'</p>').join(''):'<strong>Sem aviso gerado</strong>')+'<p class=\"muted\">'+esc(a.nota||'')+'</p><details><summary>Ver indicadores</summary>'+esc(a.evidencia||'Sem dados suficientes')+'</details></td><td>'+esc(a.fonte)+'<br>'+esc(a.data||'Sem data')+'<br>'+esc(a.periodo||'Período por confirmar')+'</td></tr>').join('')+'</tbody></table>':'<p>Sem anúncios com ligação confirmada para avaliar.</p>')+'<p class=\"warning\">Sem aviso não significa bom desempenho. Pode faltar histórico, período completo ou métricas compatíveis. Os avisos descrevem dados recolhidos e não identificam a causa.</p>';}\nfunction mostrar(){const x=modelo.imoveis.find(x=>x.ref===el('ref').value);if(!x){el('detail').innerHTML='<p>Não existem imóveis com prioridade «Prioritária».</p>';return;}const url=modelo.url+'#gid='+modelo.levantamentoId+'&range=A'+x.linha;el('detail').innerHTML='<h2>'+esc(x.ref)+'</h2><p class=\"muted\">'+esc(x.natureza+' · '+x.concelho)+' · Última verificação registada: '+esc(x.data||'Sem data')+' · <a href=\"'+esc(url)+'\">Ver no levantamento</a></p>'+'<p><strong>Website da agência:</strong> '+esc(x.website||'Por verificar')+'</p>'+(x.duplicada?'<p class=\"warning\">Referência duplicada: rever as linhas antes de usar as associações.</p>':'')+(x.presenca?'':'<table><thead><tr><th>Portal</th><th>Cobertura</th></tr></thead><tbody>'+x.portais.map(p=>'<tr><td>'+esc(p.portal)+'</td><td>'+esc(p.estado)+(p.confirmadas?' · '+p.confirmadas+' anúncio(s)':'')+(p.porRever?' · '+p.porRever+' por rever':'')+'</td></tr>').join('')+'</tbody></table>')+presencaHtml(x.presenca)+alertasHtml(x.alertas)+comparacaoHtml(x.comparacao)+'<p class=\"warning\">«Preenchido» é o estado registado, não uma avaliação da qualidade. «Digitalizado» continua a exigir inserção no eGO. Não existe pontuação global nesta consulta.</p><table><thead><tr><th>Critério</th><th>Estado registado</th><th>Fonte</th></tr></thead><tbody>'+x.criterios.map(c=>'<tr><td>'+esc(c.nome)+'</td><td class=\"'+c.classe+'\">'+esc(c.valor)+'</td><td>'+esc(c.fonte)+'</td></tr>').join('')+'</tbody></table><h2>Acompanhamento da equipa</h2><p class=\"muted\">'+esc(x.resumo||'Sem resumo registado. Consultar as pendências da equipa.')+'</p>';}\nconst inicial=/*AP_INICIAL*/null;if(inicial)renderizar(inicial,'');else carregar();</script></body></html>\n";
const LISTA_HTML = "<!doctype html>\n<html lang=\"pt\"><head><base target=\"_top\"><meta charset=\"utf-8\">\n<style>\nbody{font-family:Arial,sans-serif;font-size:13px;color:#202124;margin:0;padding:12px}\nh3{font-size:14px;margin:16px 0 6px}\n.muted{color:#5f6368;font-size:12px}\n.barra{background:#e8eaed;border-radius:4px;height:8px;margin:4px 0 2px}\n.barra div{background:#188038;height:8px;border-radius:4px}\n.item{border-left:3px solid #1a73e8;background:#f8f9fa;padding:6px 8px;margin:6px 0}\n.item.sara{border-left-color:#f9ab00}\n.item .ref{cursor:pointer;color:#087f8c;background:none;border:0;padding:0;margin:0;min-height:28px;font-weight:bold}input{width:100%;box-sizing:border-box;padding:9px;border:1px solid #91a8b4;border-radius:6px;margin:6px 0 10px}button:focus-visible,input:focus{outline:3px solid #79c5d3;outline-offset:2px}\n.item ul{margin:4px 0 0 16px;padding:0}\na{color:#1a73e8}\nbutton{background:#fff;color:#1a73e8;border:1px solid #dadce0;border-radius:6px;padding:6px 12px;font-size:12px;cursor:pointer;margin-top:8px}\n</style></head>\n<body>\n<button onclick=\"google.script.run.abrirImoveisPortais()\">Ficha por imóvel · eGO e portais</button><p class=\"muted\">Consulta ligações confirmadas e resultados por plataforma.</p>\n<label for=\"pesquisa\"><b>Procurar referência ou localidade</b></label><div class=\"muted\">Pesquisa nos imóveis e pendências apresentados neste painel.</div><input id=\"pesquisa\" placeholder=\"Ex.: APT14077 ou Faro\" type=\"search\"><div id=\"filtro\" class=\"muted\" role=\"status\"></div><div id=\"out\" aria-live=\"polite\">A carregar…</div>\n<button onclick=\"carregar()\">Atualizar</button>\n<script>\nfunction esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/\"/g,'&quot;').replace(/'/g,'&#39;');}\nfunction ir(sep,l){google.script.run.irPara(sep,l);}\nfunction liga(u){return /^https?:\\/\\//.test(u||'')?' · <a href=\"'+esc(u)+'\" target=\"_blank\">página pública</a>':'';}\nfunction barra(a,b,t){const p=b?Math.round(100*a/b):0;return '<div>'+t+': <b>'+a+' de '+b+'</b></div><div class=\"barra\"><div style=\"width:'+p+'%\"></div></div>';}\nlet dadosLista=null;\nfunction normalizar(s){return String(s||'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase();}\nfunction mostrar(orig){\n  dadosLista=orig;const q=normalizar(document.getElementById('pesquisa').value),match=x=>!q||normalizar(JSON.stringify(x)).includes(q),d=Object.assign({},orig);\n  ['prioritarios','minhas','sara','perfis','alta'].forEach(k=>d[k]=(orig[k]||[]).filter(match));\n  document.getElementById('filtro').textContent=q?'Resultados filtrados. Limpa a pesquisa para ver tudo.':'';\n\n  let h='<h3>Progresso</h3>'+barra(d.contagem['Prioritária'][0],d.contagem['Prioritária'][1],'Prioritários verificados')+barra(d.verificados,d.total,'Todos os imóveis verificados');\n  h+='<h3>1. Prioritários por verificar ('+d.prioritarios.length+')</h3>';\n  h+=d.prioritarios.length?d.prioritarios.map(im=>'<div class=\"item\"><button class=\"ref\" onclick=\"ir(\\'Levantamento\\','+im.linha+')\">'+esc(im.ref)+'</button> · '+esc(im.natureza)+' · '+esc(im.concelho)+liga(im.url)+'</div>').join(''):'<div class=\"muted\">'+(q?'Sem correspondência.':'Todos verificados.')+'</div>';\n  h+='<h3>2. As tuas pendências ('+d.minhas.reduce((n,x)=>n+x.pendencias.length,0)+' em '+d.minhas.length+' imóveis)</h3>';\n  h+=d.minhas.length?d.minhas.map(im=>'<div class=\"item\"><button class=\"ref\" onclick=\"ir(\\'Pendências da equipa\\','+im.pendencias[0].linha+')\">'+esc(im.ref)+'</button> '+(im.prioridade==='Prioritária'?'· prioritário':'')+liga(im.url)+'<ul>'+im.pendencias.map(p=>'<li>'+esc(p.assunto)+'<div class=\"muted\">'+esc(p.acao)+'</div></li>').join('')+'</ul></div>').join(''):'<div class=\"muted\">Nenhuma.</div>';\n  h+='<h3>3. À espera da Sara ('+d.sara.length+')</h3>';\n  h+=d.sara.length?d.sara.map(p=>'<div class=\"item sara\"><button class=\"ref\" onclick=\"ir(\\'Pendências da equipa\\','+p.linha+')\">'+esc(p.ref)+'</button> · '+esc(p.assunto)+'</div>').join(''):'<div class=\"muted\">Nenhuma.</div>';\n  h+='<h3>4. Perfis dos portais ('+d.perfis.length+')</h3>';\n  h+=d.perfis.length?d.perfis.map(p=>'<div class=\"item\"><button class=\"ref\" onclick=\"ir(\\''+(p.origem==='Perfis dos portais'?'Perfis dos portais':'Pendências da equipa')+'\\','+p.linha+')\">'+esc(p.portal)+'</button> · '+esc(p.assunto)+(p.url?' · <a href=\"'+esc(p.url)+'\" target=\"_blank\">perfil</a>':'')+'<div class=\"muted\">'+esc(p.estado)+': '+esc(p.acao)+'</div></div>').join(''):'<div class=\"muted\">Nada em aberto.</div>';\n  if(!orig.prioritarios.length&&d.altaTotal)h+='<h3>Depois: prioridade Alta por verificar ('+d.altaTotal+')</h3>'+d.alta.map(im=>'<div class=\"item\"><button class=\"ref\" onclick=\"ir(\\'Levantamento\\','+im.linha+')\">'+esc(im.ref)+'</button> · '+esc(im.natureza)+' · '+esc(im.concelho)+liga(im.url)+'</div>').join('');\n  h+='<p class=\"muted\">Carrega numa referência para ir à linha no Sheet.</p>';\n  document.getElementById('out').innerHTML=h;\n}\nfunction carregar(){document.getElementById('out').textContent='A carregar…';google.script.run.withSuccessHandler(mostrar).withFailureHandler(e=>document.getElementById('out').textContent=/PERMISSION_DENIED|authorization/i.test(e.message||'')?'Esta sessão Google não permitiu aceder à folha. Reabre o documento com a conta autorizada.':e.message).listaTrabalho();}\ndocument.getElementById('pesquisa').addEventListener('input',()=>{if(dadosLista)mostrar(dadosLista);});\ncarregar();\n</script>\n</body></html>\n";
const RESUMO_HTML = "<!doctype html>\n<html><head><base target=\"_top\"><meta charset=\"utf-8\">\n<style>\nbody{font-family:Arial,sans-serif;font-size:13px;color:#202124;margin:0;padding:12px}\nlabel{display:block;font-size:12px;color:#5f6368;margin-top:8px}\nselect,input,textarea{width:100%;box-sizing:border-box;font-size:13px;padding:4px}\nbutton{background:#1a73e8;color:#fff;border:0;border-radius:6px;padding:8px 12px;font-size:13px;cursor:pointer;margin:8px 6px 0 0}\nbutton:disabled{opacity:.5;cursor:default}\nbutton.sec{background:#fff;color:#1a73e8;border:1px solid #dadce0}\n#prev{border:1px solid #dadce0;border-radius:6px;padding:8px;margin-top:10px;font-size:12px;max-height:450px;overflow:auto;background:#fff}\n#dias{max-width:220px}\n.ok{color:#188038;margin-top:8px}.muted{color:#5f6368;font-size:12px}\n</style></head>\n<body>\n<p class=\"muted\">Correções documentadas, verificações e registos no Sheets são apresentados separadamente. O email só é copiado; o envio é manual.</p>\n<p><strong>Para:</strong> Sara<br><strong>Cc:</strong> Idília e Júlia</p>\n<label for=\"dias\">Período</label>\n<select id=\"dias\" onchange=\"ver()\"><option value=\"7\">Últimos 7 dias</option><option value=\"14\">Últimos 14 dias</option><option value=\"30\">Últimos 30 dias</option></select>\n<label for=\"plano\">Seguimento previsto para a próxima semana</label><textarea id=\"plano\" rows=\"4\" placeholder=\"Um próximo passo por linha. Escreve apenas o que planeias fazer.\" oninput=\"invalidar()\"></textarea>\n<button class=\"sec\" onclick=\"ver()\">Atualizar resumo</button>\n<label for=\"assunto\">Assunto</label><input id=\"assunto\" readonly onclick=\"this.select()\">\n<button id=\"copiarAssunto\" class=\"sec\" disabled onclick=\"copiarAssunto()\">Copiar assunto</button><button id=\"copiarEmail\" disabled onclick=\"copiarEmail()\">Copiar email</button>\n<div id=\"msg\" class=\"ok\" role=\"status\" aria-live=\"polite\"></div>\n<div id=\"prev\">A preparar…</div>\n<p class=\"muted\">Para documentar uma correção numa pendência, descreve a ação na Resposta / decisão. Exemplo: «Correção realizada no eGO: certificado carregado». Concluído ou Preenchido, por si só, não comprovam essa alteração.</p>\n<p class=\"muted\">Abre o webmail da Janela (janela.pt/webmail), cria uma mensagem para a Sara com a Idília e a Júlia em Cc, cola o assunto e o email (Ctrl+V). Revê e envia tu.</p>\n<script>\nlet revisao=0,pendente=null,aprovado=null,timerAviso=null;\nconst campo=id=>document.getElementById(id);\nfunction entradaAtual(){return{dias:+campo('dias').value,plano:campo('plano').value};}\nfunction coincide(p){const a=entradaAtual();return p&&p.revisao===revisao&&p.dias===a.dias&&p.plano===a.plano;}\nfunction mensagem(t){if(timerAviso!==null){clearTimeout(timerAviso);timerAviso=null;}campo('msg').textContent=t;}\nfunction bloquear(){campo('copiarEmail').disabled=true;campo('copiarAssunto').disabled=true;campo('assunto').value='';}\nfunction invalidar(){revisao++;pendente=null;aprovado=null;bloquear();campo('prev').textContent='Alterações por atualizar.';mensagem('Atualiza o resumo para incluir o plano e o período atuais.');}\nfunction falhaAtual(p,e){if(!coincide(p))return;pendente=null;aprovado=null;bloquear();campo('prev').textContent=e.message||'Não foi possível preparar o resumo. Tenta atualizar novamente.';mensagem('O resumo não está pronto para copiar. O plano foi mantido.');}\nfunction receberResumo(r,p){\n  if(!coincide(p))return;\n  if(!r||typeof r.html!=='string'||typeof r.assunto!=='string'||!Array.isArray(r.proximosPassos)){falhaAtual(p,{message:'O resumo recebido está incompleto. Atualiza novamente.'});return;}\n  pendente=null;aprovado=p;campo('prev').innerHTML=r.html;campo('assunto').value=r.assunto;campo('copiarAssunto').disabled=false;campo('copiarEmail').disabled=!r.proximosPassos.length;\n  mensagem(r.proximosPassos.length?'Resumo atualizado. Revê antes de copiar.':'Preenche o seguimento da próxima semana e carrega em Atualizar resumo.');\n}\nfunction ver(){\n const a=entradaAtual();if(pendente&&coincide(pendente))return;\n const p={...a,revisao:++revisao};pendente=p;aprovado=null;bloquear();campo('prev').textContent='A preparar…';mensagem('A preparar o resumo para o plano e período atuais…');\n google.script.run.withSuccessHandler(r=>receberResumo(r,p)).withFailureHandler(e=>falhaAtual(p,e)).previewResumo(p.dias,p.plano);\n}\nfunction aviso(t){mensagem(t);const atual=revisao;timerAviso=setTimeout(()=>{if(atual===revisao)campo('msg').textContent='';timerAviso=null;},4000);}\nfunction pronto(email){if(!coincide(aprovado)||pendente||(email?campo('copiarEmail').disabled:campo('copiarAssunto').disabled)){invalidar();return false;}return true;}\nfunction copiarAssunto(){if(!pronto(false))return;const i=campo('assunto');i.select();const ok=document.execCommand('copy');aviso(ok?'Assunto copiado.':'Seleciona o assunto e usa Ctrl+C.');}\nfunction copiarEmail(){if(!pronto(true))return;const el=campo('prev'),r=document.createRange();r.selectNodeContents(el);const s=window.getSelection();s.removeAllRanges();s.addRange(r);const ok=document.execCommand('copy');s.removeAllRanges();aviso(ok?'Email copiado, com a tabela. Cola no webmail.':'Não consegui copiar: seleciona o texto acima e usa Ctrl+C.');}\n\nconst inicial=/*RS_INICIAL*/null;if(inicial){const a=entradaAtual(),p={...a,revisao:++revisao};pendente=p;receberResumo(inicial,p);}else ver();\n</script>\n</body></html>\n";
const MARCADOR_JS = "(async () => { function painelMarcadorClara() { const id='clara-recolha-painel',anterior=document.getElementById(id); if(anterior&&anterior.dataset.busy==='true')return null; if(anterior)anterior.remove(); const host=document.createElement('div');host.id=id;host.dataset.busy='true'; Object.assign(host.style,{position:'fixed',right:'16px',bottom:'16px',width:'min(360px, calc(100vw - 32px))',zIndex:'2147483647'}); const root=host.attachShadow({mode:'open'}),style=document.createElement('style'); style.textContent='*{box-sizing:border-box}section{font:14px/1.45 Arial,sans-serif;background:#fff;color:#183746;border:1px solid #d9e3e9;border-radius:12px;box-shadow:0 6px 30px #18374638;padding:16px}header{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}strong{font-size:17px}p{margin:7px 0}.help{font-size:12px;color:#526b78}button{font:600 13px Arial,sans-serif;border:0;border-radius:6px;padding:9px 12px;cursor:pointer;background:#087f8c;color:white}button.close{background:#eef3f6;color:#183746;padding:5px 9px}button:disabled{opacity:.5;cursor:wait}textarea{width:100%;height:100px;resize:vertical;font:12px Arial;border:1px solid #91a8b4;border-radius:5px;padding:8px;margin:8px 0}button:focus-visible,textarea:focus{outline:3px solid #79c5d3;outline-offset:2px}[hidden]{display:none!important}'; root.appendChild(style);const section=document.createElement('section');section.setAttribute('role','region');section.setAttribute('aria-label','Recolha Clara'); const header=document.createElement('header'),title=document.createElement('strong'),close=document.createElement('button');title.textContent='Clara';close.textContent='×';close.className='close';close.setAttribute('aria-label','Fechar confirmação da recolha');close.disabled=true;close.addEventListener('click',()=>host.remove());header.append(title,close); const status=document.createElement('p'),help=document.createElement('p'),manual=document.createElement('textarea'),cop