  if(!listas.length)return 'Ainda não há páginas da lista guardadas.';
  const dia=listas.map(function(r){return String(r[0]);}).sort().pop(), lotes={};
  listas.filter(function(r){return String(r[0])===dia;}).forEach(function(r){
