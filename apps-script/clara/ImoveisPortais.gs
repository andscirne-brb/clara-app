function identificarProximosImoveisPortais(){
 const lock=LockService.getDocumentLock();if(!lock.tryLock(1000))throw Error('Outra gravação em curso.');let ss,old,items;try{ss=SpreadsheetApp.getActive();old=ipTabela_(ss,'Ligações dos portais',9,IP_LIGACOES);items=old.filter(r=>['Green-Acres','Rightmove'].includes(r[0])&&r[4]==='Por identificar'&&!r[8]).slice(0,5).map(r=>({portal:r[0],id:String(r[1]),url:r[6]}));}finally{lock.releaseLock();}
 if(!items.length)return{processados:0,mensagem:'Não há fichas novas por identificar. Os casos por rever não são repetidos automaticamente.'};
 const results=ipLerPublicas_(items);if(!lock.tryLock(1000))throw Error('Os resultados não foram guardados porque existe outra gravação em curso.');try{const ego=ipEgo_(ss),latest=ipTabela_(ss,'Ligações dos portais',9,IP_LIGACOES),date=Utilities.formatDate(new Date(),ss.getSpreadsheetTimeZone(),'yyyy-MM-dd'),rows=latest.map(r=>{const found=results.find(w=>w.c.portal===r[0]&&w.c.id===String(r[1])),before=old.find(o=>o[0]===r[0]&&String(o[1])===String(r[1]));if(!found)return r;if(JSON.stringify(r)!==JSON.stringify(before))throw Error('Uma ligação mudou durante a consulta. Não substituí a alteração.');const a=r.slice();a[3]=found.ref;a[4]=found.erro?'Por rever':ipEstado_(found.ref,ego);a[7]=date;a[8]=found.erro;return a;});ipGuardarLigacoes_(ss,latest,rows);ipEscrever_(ss,'Imóveis nos portais',IP_VISTA,ipVista_(ego,rows));return{processados:results.length,confirmadas:rows.filter(r=>r[4]==='Confirmada').length,restantes:rows.filter(r=>r[4]==='Por identificar'&&!r[8]).length,mensagem:'Lote conferido e guardado. Podes continuar com mais cinco fichas.'};}finally{lock.releaseLock();}
}
function ipResultados_(ss,r){
 if(r[0]==='Idealista'){const data=ipTabela_(ss,'Idealista - recolhas',13,IDEALISTA_CABECALHOS).filter(x=>String(x[6])===String(r[1])&&x[1]==='ranking');if(!data.length)return{periodo:'Sem estatísticas de ranking guardadas',metricas:[]};const last=data[data.length-1],group=data.filter(x=>x[10]===last[10]),seen={};group.forEach(x=>{if(['visitasListas','visitasDetalhes','contactos','favoritos'].includes(x[7]))seen[x[7]]=x[8];});return{periodo:ipData_(last[2])+' a '+ipData_(last[3]),recolha:ipData_(last[0]),metricas:Object.entries(seen).map(([nome,valor])=>({nome,valor})),aviso:'Ranking histórico; presença atual deve ser confirmada na carteira ativa.'};}
 if(r[0]==='Green-Acres'){const rows=ipTabela_(ss,'Green-Acres - anúncios',20,GA_ANUNCIOS_HEADERS).filter(x=>String(x[3])===String(r[1]));if(!rows.length)return{periodo:'Sem estatísticas por anúncio'};const x=rows[rows.length-1];return{periodo:String(x[1]),recolha:ipData_(x[0]),metricas:['Visualizações em lista','Visitas','Emails','Favoritos'].map((nome,i)=>({nome,valor:x[13+i]})),preco:x[8],fotos:x[11],planta:x[12]==='Sim'?'Sem planta assinalado no portal':'Sem aviso de falta de planta',aviso:'Atualização do portal a cada 24 h. '+x[5]+' · '+x[6]};}
 const rows=ipTabela_(ss,'Rightmove - desempenho',16,RM_PERF_HEADERS).filter(x=>String(x[3])===String(r[1])&&Number(x[2])===30);if(!rows.length)return{periodo:'Sem estatísticas de 30 dias'};const x=rows[rows.length-1];return{periodo:'Janela de 30 dias; dados até '+ipData_(x[1]),recolha:ipData_(x[0]),metricas:[{nome:'Visitas diárias médias',valor:x[10]}],preco:x[6],fotos:x[7],planta:typeof x[8]==='number'?x[8]+' plantas':'Por confirmar',aviso:'Média diária; não equivale a visitas totais nem a leads.'};
}
function fichaImovelPortais(ref){ref=ipRef_(ref);if(!/^[A-Z0-9_-]{1,40}$/.test(ref))throw Error('Indica a referência eGO completa.');const ss=SpreadsheetApp.getActive(),ego=ipEgo_(ss),e=ego[ref];if(!e)return{ref,erro:'Referência não encontrada no levantamento.'};if(e.linhas.length!==1)return{ref,erro:'Referência duplicada no levantamento. É necessário rever.'};const lig=ipTabela_(ss,'Ligações dos portais',9,IP_LIGACOES).filter(r=>ipRef_(r[3])===ref),portais=lig.map(r=>({portal:r[0],id:String(r[1]),estado:r[4],url:r[6],fonte:r[5],data:ipData_(r[7]),nota:r[8],dados:r[4]==='Confirmada'?ipResultados_(ss,r):null}));return{ref,natureza:e.natureza,concelho:e.concelho,estado:e.estado,faltas:e.faltas,linha:e.linhas[0],portais,aviso:'Não somar períodos ou métricas diferentes. Sem ligação confirmada não significa ausência de publicação. Os resultados ainda não criam pendências nem alteram o eGO.'};}
