 return '';
}
function ipCandidatos_(ss){
 const out={},put=c=>{const key=c.portal+'|'+c.id;if(!c.url)return;const old=out[key];if(!old||c.recolha>=old.recolha)out[key]=c;};
 ipTabela_(ss,'Idealista - recolhas',13,IDEALISTA_CABECALHOS).forEach(r=>{if(!['lista','ranking','carteira_ativa'].includes(r[1])||!/^\d+$/.test(String(r[6])))return;const id=String(r[6]);put({portal:'Idealista',id,refPortal:String(r[5]||''),ref:ipRef_(r[5]),url:ipUrl_('Idealista',id),recolha:ipData_(r[0]),fonte:r[1]==='carteira_ativa'?'Carteira ativa Idealista':'Referência interna Idealista'});});
