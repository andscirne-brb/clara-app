 return Object.values(out).sort((a,b)=>a.portal.localeCompare(b.portal)||a.id.localeCompare(b.id));
}
function ipEstado_(ref,ego){return !ref?'Por identificar':!ego[ref]?'Referência ausente no levantamento':ego[ref].linhas.length!==1?'Referência duplicada no levantamento':'Confirmada';}
function ipCombinar_(candidatos,old,ego,data){
 const map={};old.forEach(r=>{if(!['Idealista','Green-Acres','Rightmove'].includes(r[0])||!ipUrl_(r[0],String(r[1]),r[6]))throw Error('Ligação existente inválida.');const k=r[0]+'|'+r[1];if(map[k])throw Error('Há ligações repetidas.');map[k]=r.slice();});
 candidatos.forEach(c=>{const k=c.portal+'|'+c.id,o=map[k],ref=c.ref||o&&ipRef_(o[3])||'';let estado=!ref&&o&&o[8]?'Por rever':ipEstado_(ref,ego),nota='';if(o&&o[4]==='Conflito de referências'){estado=o[4];nota=String(o[8]||'');}else if(o&&o[4]==='Confirmada'&&c.ref&&ipRef_(o[3])!==c.ref){estado='Conflito de referências';nota='A referência da fonte diverge da ligação anterior; não associar até revisão.';}
 map[k]=[c.portal,c.id,c.refPortal,o&&o[4]==='Confirmada'?o[3]:ref,estado,o&&o[5]||c.fonte,c.url,o&&o[7]||data,nota||o&&o[8]||''];});
 return Object.values(map).map(r=>{if(r[4]!=='Conflito de referências'&&r[3])r[4]=ipEstado_(ipRef_(r[3]),ego);return r;}).sort((a,b)=>a[0].localeCompare(b[0])||String(a[1]).localeCompare(String(b[1])));
}
function ipEscrever_(ss,nome,headers,rows){
 let sh=ss.getSheetByName(nome),novo=!sh;if(!sh)sh=ss.insertSheet(nome);if(sh.getLastRow()&&sh.getRange(1,1,1,headers.length).getDisplayValues()[0].join('|')!==headers.join('|'))throw Error('Estrutura alterada em '+nome+'.');
 if(sh.getLastRow()&&sh.getRange(1,1,sh.getLastRow(),headers.length).getFormulas().some(r=>r.some(Boolean)))throw Error('Existem fórmulas em '+nome+'. Não substituí a folha.');const n=Math.max(rows.length+1,sh.getLastRow(),1),old=sh.getRange(1,1,sh.getLastRow()||1,headers.length).getValues();if(sh.getMaxRows()<n)sh.insertRowsAfter(sh.getMaxRows(),n-sh.getMaxRows());const all=[headers,...rows],values=all.concat(Array.from({length:n-all.length},()=>Array(headers.length).fill(''))),literal=values.map(r=>r.map(v=>typeof v==='string'?"'"+v:v));
 try{sh.getRange(1,1,n,headers.length).setValues(literal);SpreadsheetApp.flush();if(JSON.stringify(sh.getRange(1,1,n,headers.length).getValues())!==JSON.stringify(values))throw Error('A conferência de '+nome+' falhou.');}catch(e){try{const back=old.concat(Array.from({length:n-old.length},()=>Array(headers.length).fill('')));sh.getRange(1,1,n,headers.length).setValues(back.map(r=>r.map(v=>typeof v==='string'?"'"+v:v)));SpreadsheetApp.flush();if(JSON.stringify(sh.getRange(1,1,n,headers.length).getValues())!==JSON.stringify(back))throw Error('Reposição divergente');}catch(err){throw Error('Falha e reposição incompleta em '+nome+'. Consulta o histórico de versões antes de repetir.');}throw e;}
 if(novo){sh.setFrozenRows(1);sh.getRange(1,1,1,headers.length).setBackground('#183746').setFontColor('#ffffff').setFontWeight('bold').setWrap(true);sh.setColumnWidths(1,headers.length,170);sh.setRowHeight(1,38);if(rows.length)sh.getRange(2,1,rows.length,headers.length).setVerticalAlignment('top').setWrap(true);}return sh;
}
function ipGuardarLigacoes_(ss,old,rows){
 if(JSON.stringify(old)===JSON.stringify(rows))return 0;
 const changes=rows.filter(r=>{const o=old.find(x=>x[0]===r[0]&&String(x[1])===String(r[1]));return !o||JSON.stringify(o)!==JSON.stringify(r);});
 const logHeaders=['Data','Portal','ID do anúncio','Estado anterior','Referência eGO anterior','Estado novo','Referência eGO nova','Fonte','Observação'],sh=ss.getSheetByName('Histórico das ligações'),logs=ipTabela_(ss,'Histórico das ligações',9,logHeaders),data=Utilities.formatDate(new Date(),ss.getSpreadsheetTimeZone(),'yyyy-MM-dd');
 const records=changes.map(r=>{const o=old.find(x=>x[0]===r[0]&&String(x[1])===String(r[1]));return[data,r[0],r[1],o?o[4]:'',o?o[3]:'',r[4],r[3],r[5],r[8]];});
 ipEscrever_(ss,'Histórico das ligações',logHeaders,logs.concat(records));try{ipEscrever_(ss,'Ligações dos portais',IP_LIGACOES,rows);}catch(e){ipEscrever_(ss,'Histórico das ligações',logHeaders,logs);throw e;}return changes.length;
}
function ipVista_(ego,ligacoes){return Object.values(ego).sort((a,b)=>a.ref.localeCompare(b.ref)).map(e=>{const links=ligacoes.filter(r=>r[3]===e.ref),ok=links.filter(r=>r[4]==='Confirmada'),cell=p=>{const a=ok.filter(r=>r[0]===p);return a.length?a.length+' anúncio(s) com ligação confirmada':'Sem ligação confirmada';};return[e.ref,e.natureza,e.concelho,e.estado,cell('Idealista'),cell('Green-Acres'),cell('Rightmove'),e.linhas.length>1?'Referência eGO duplicada':links.some(r=>r[4]!=='Confirmada')?'Há ligações por rever':''];});}
function atualizarImoveisPortais(){const lock=LockService.getDocumentLock();if(!lock.tryLock(1000))throw Error('Outra gravação em curso. Tenta novamente.');try{const ss=SpreadsheetApp.getActive(),ego=ipEgo_(ss),old=ipTabela_(ss,'Ligações dos portais',9,IP_LIGACOES),data=Utilities.formatDate(new Date(),ss.getSpreadsheetTimeZone(),'yyyy-MM-dd'),rows=ipCombinar_(ipCandidatos_(ss),old,ego,data),alteradas=ipGuardarLigacoes_(ss,old,rows);ipEscrever_(ss,'Imóveis nos portais',IP_VISTA,ipVista_(ego,rows));return{total:rows.length,confirmadas:rows.filter(r=>r[4]==='Confirmada').length,porRever:rows.filter(r=>r[4]!=='Confirmada').length,alteradas};}finally{lock.releaseLock();}}
function ipTexto_(s){return String(s||'').replace(/<[^>]*>/g,' ').replace(/&nbsp;|&#160;/g,' ').replace(/&amp;/g,'&').replace(/\s+/g,' ').trim();}
function ipExtrairRef_(portal,html){
 if(typeof html!=='string'||html.length>4000000)throw Error('Ficha demasiado extensa.');let refs=[];
 if(portal==='Green-Acres'){const blocks=html.match(/<div\b[^>]*class=["'][^"']*\blabel-value\b[^"']*["'][^>]*>[\s\S]{0,2000}?<\/div>/gi)||[];blocks.forEach(b=>{if(/<label[^>]*>\s*Número de mandato\s*<\/label>/i.test(b)){const m=/<p[^>]*>([\s\S]*?)<\/p>/i.exec(b);if(m)refs.push(ipRef_(ipTexto_(m[1])));}});}
 else if(portal==='Rightmove'){const pattern=/#ref\s*:\s*([A-Za-z]{1,6}\d{3,10})(?![A-Za-z0-9])/gi;let m;while((m=pattern.exec(html)))refs.push(ipRef_(m[1]));}
 refs=[...new Set(refs)].filter(x=>/^[A-Z]{1,6}\d{3,10}$/.test(x));if(refs.length>1)throw Error('A ficha contém referências divergentes.');return refs[0]||'';
