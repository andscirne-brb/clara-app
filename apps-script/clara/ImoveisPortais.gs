function ipRef_(r){return String(r||'').trim().toUpperCase();}
function ipData_(v){return v instanceof Date?Utilities.formatDate(v,SpreadsheetApp.getActive().getSpreadsheetTimeZone(),'yyyy-MM-dd'):String(v||'').slice(0,10);}
function ipTabela_(ss,n,w,h){const s=ss.getSheetByName(n);if(!s||!s.getLastRow())return[];if(h&&s.getRange(1,1,1,w).getDisplayValues()[0].join('|')!==h.join('|'))throw Error('A estrutura de '+n+' mudou.');return s.getLastRow()>1?s.getRange(2,1,s.getLastRow()-1,w).getValues():[];}
function ipEgo_(ss){const s=ss.getSheetByName(LEV.nome);if(!s)throw Error('Levantamento não encontrado.');const h=s.getRange(9,1,1,s.getLastColumn()).getDisplayValues()[0],v=s.getLastRow()>9?s.getRange(10,1,s.getLastRow()-9,h.length).getDisplayValues():[],col=n=>h.indexOf(n),ri=col('Referência EGO');if(ri<0)throw Error('Referência EGO não encontrada.');const out={};v.forEach((r,i)=>{const ref=ipRef_(r[ri]);if(!ref)return;const e=out[ref]||(out[ref]={ref,linhas:[],natureza:r[col('Natureza')]||'',concelho:r[col('Concelho')]||'',estado:r[col('Estado da verificação')]||'',faltas:r[col('Categorias com faltas')]||''});e.linhas.push(i+10);});return out;}
function ipUrl_(p,id,url){
