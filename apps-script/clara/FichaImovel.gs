const IP_FICHA_HEADERS=['Ficha por imóvel','','','','','','','',''];
function ipModeloFicha_(f){
 const n=Math.max(27,10+16*Math.max(1,...['Idealista','Green-Acres','Rightmove'].map(p=>(f.portais||[]).filter(x=>x.portal===p).length))),rows=Array.from({length:n-1},()=>Array(9).fill('')),put=(r,c,v)=>rows[r-2][c-1]=v==null?'':String(v);
 put(2,1,'Estado eGO e resultados por portal · períodos apresentados separadamente');put(3,1,'Referência eGO');put(3,2,f.ref||'');put(3,4,'Estado eGO');put(3,5,f.estado||'Sem dados');put(3,7,'Concelho');put(3,8,f.concelho||'');put(4,1,'Escolhe ou escreve a referência na célula B3. A ficha atualiza automaticamente.');put(5,1,'Natureza');put(5,2,f.natureza||'');put(5,4,'Faltas no eGO');put(5,5,f.faltas||'Consultar o levantamento');put(6,1,f.erro||f.aviso||'Sem ligação confirmada não significa ausência de publicação.');
 ['Idealista','Green-Acres','Rightmove'].forEach((p,i)=>{const col=1+i*3;put(8,col,p);const entries=(f.portais||[]).filter(x=>x.portal===p);if(!entries.length){put(9,col,'Sem ligação confirmada');put(10,col,'Publicação por verificar');return;}entries.forEach((x,j)=>{const r=9+j*16,d=x.dados;put(r,col,x.estado);put(r+1,col,'Anúncio: '+x.id);if(d){put(r+2,col,'Período: '+d.periodo);(d.metricas||[]).forEach((m,k)=>put(r+3+k,col,m.nome+': '+m.valor));if(d.preco!==undefined)put(r+7,col,'Preço: '+d.preco+' €');if(d.fotos!==undefined)put(r+8,col,'Fotografias: '+(d.fotos===''?'Por confirmar':d.fotos));put(r+9,col,d.planta||'');put(r+12,col,d.aviso||'');put(r+13,col,d.recolha?'Recolha: '+d.recolha:'');}put(r+10,col,x.fonte+' · '+x.data);put(r+11,col,x.url);put(r+14,col,x.nota||'');});});return rows;
}
function mostrarFichaImovel(ref){
 const lock=LockService.getDocumentLock();if(!lock.tryLock(1000))throw Error('Outra atualização em curso. Volta a escolher a referência daqui a instantes.');try{const ss=SpreadsheetApp.getActive(),f=ref?fichaImovelPortais(ref):{ref:'',portais:[],erro:'Seleciona uma referência eGO em B3 para consultar o imóvel.'},existing=ss.getSheetByName('Ficha do imóvel');if(existing){if(existing.getRange(1,1,1,9).getDisplayValues()[0].join('|')!==IP_FICHA_HEADERS.join('|'))throw Error('A estrutura da ficha foi alterada.');existing.getRange(1,1,existing.getLastRow(),9).breakApart();}
 const rows=ipModeloFicha_(f),sh=ipEscrever_(ss,'Ficha do imóvel',IP_FICHA_HEADERS,rows),last=rows.length+1;sh.setColumnWidths(1,9,112);sh.setFrozenRows(3);sh.getRange(1,1,last,9).setFontFamily('Arial').setFontSize(11).setBackground('#ffffff').setFontColor('#183746').setVerticalAlignment('middle').setWrap(true);sh.getRange(1,1,1,9).mergeAcross().setBackground('#183746').setFontColor('#ffffff').setFontSize(20).setFontWeight('bold');sh.setRowHeight(1,46);
 [2,4,6].forEach(r=>sh.getRange(r,1,1,9).mergeAcross().setFontSize(11).setFontColor('#526b78'));sh.getRange(3,2,1,2).mergeAcross().setBackground('#dff0f4').setFontWeight('bold');sh.getRange(3,5,1,2).mergeAcross();sh.getRange(3,8,1,2).mergeAcross();sh.getRange(5,2,1,2).mergeAcross();sh.getRange(5,5,1,5).mergeAcross();sh.setRowHeight(3,38);sh.setRowHeight(6,42);
 const colors=['#dafa75','#075545','#171735'];for(let i=0;i<3;i++){const c=1+i*3;sh.getRange(8,c,1,3).mergeAcross().setBackground(colors[i]).setFontColor(i?'#ffffff':'#183746').setFontWeight('bold').setFontSize(14);sh.getRange(9,c,last-8,3).mergeAcross();}sh.setRowHeight(8,38);sh.setRowHeight(5,52);if(last>8)sh.setRowHeights(9,last-8,34);for(let r=9;r+14<=last;r+=16){sh.setRowHeight(r+11,54);sh.setRowHeight(r+12,68);sh.setRowHeight(r+14,54);}
 const lev=ss.getSheetByName(LEV.nome),h=lev.getRange(9,1,1,lev.getLastColumn()).getDisplayValues()[0],idx=h.indexOf('Referência EGO')+1;if(idx>0&&lev.getLastRow()>9)sh.getRange(3,2).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInRange(lev.getRange(10,idx,lev.getLastRow()-9,1),true).setAllowInvalid(false).build());return{ref:f.ref||'',erro:f.erro||'',folha:'Ficha do imóvel'};
 }finally{lock.releaseLock();}
}
function abrirImoveisPortais(){const ss=SpreadsheetApp.getActive(),active=ss.getActiveSheet(),range=ss.getActiveRange();let ref='';if(range&&((active.getName()===LEV.nome&&range.getRow()>9)||(active.getName()==='Imóveis nos portais'&&range.getRow()>1)))ref=active.getRange(range.getRow(),1).getDisplayValue();else{const f=ss.getSheetByName('Ficha do imóvel');if(f)ref=f.getRange(3,2).getDisplayValue();}atualizarImoveisPortais();mostrarFichaImovel(ref);const sh=ss.getSheetByName('Ficha do imóvel');sh.showSheet();sh.activate();sh.getRange(3,2).activate();}
