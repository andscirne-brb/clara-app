const GA_HEADERS=['Data da recolha','Conta','Sites','Relatório','Início da série','Fim da série','Data','Indicador','Valor','Cobertura','ID da recolha','Fonte'];
function abrirGreenAcres(){abrirPainelPlataforma_('green-acres');}
function validarGreenAcres_(texto){
 if(typeof texto!=='string'||texto.length>2000000||!texto.startsWith('CLARA4:'))throw Error('Leitura Green-Acres inválida.');const x=JSON.parse(texto.slice(7)),iso=s=>typeof s==='string'&&/^\d{4}-\d{2}-\d{2}$/.test(s)&&Number.isFinite(Date.parse(s+'T00:00:00Z'))&&new Date(s+'T00:00:00Z').toISOString().slice(0,10)===s;
 if(x.v!==4||x.origem!=='green-acres'||x.url!=='https://back.green-acres.com/pt/Agent'||!/^\d{1,20}$/.test(x.conta||'')||x.sites!=='all'||!iso(String(x.lido||'').slice(0,10))||!Array.isArray(x.relatorios)||x.relatorios.length!==5)throw Error('Origem ou cobertura Green-Acres inválida.');
 const kinds={visitas:1,emails:1,listas:1,anuncios:2,mensal:2},seen=new Set(),lido=x.lido.slice(0,10);
 const relatorios=x.relatorios.map(r=>{if(!kinds[r.codigo]||seen.has(r.codigo)||!Array.isArray(r.linhas)||!r.linhas.length||r.linhas.length>4000)throw Error('Relatório Green-Acres inválido ou repetido.');seen.add(r.codigo);let previous='',faltam=0;
 const linhas=r.linhas.map(row=>{if(!iso(row.data)||row.data<=previous||row.data>lido||r.codigo==='mensal'&&!row.data.endsWith('-01')||!Array.isArray(row.valores)||row.valores.length!==kinds[r.codigo]||row.valores.some(v=>typeof v!=='number'||!Number.isSafeInteger(v)||v<0))throw Error('Data, ordem ou valor Green-Acres inválido.');if(previous&&r.codigo!=='mensal')faltam+=Math.round((Date.parse(row.data)-Date.parse(previous))/86400000)-1;previous=row.data;return{data:row.data,valores:row.valores.slice()};});
 if(r.inicio!==linhas[0].data||r.fim!==linhas[linhas.length-1].data||r.faltamDias!==faltam)throw Error('Cobertura de datas incoerente.');return{codigo:r.codigo,inicio:r.inicio,fim:r.fim,faltamDias:faltam,linhas};}).sort((a,b)=>a.codigo.localeCompare(b.codigo));
 return{v:4,origem:'green-acres',url:x.url,conta:String(x.conta),sites:'all',lido,relatorios};
}
function prepararGreenAcres_(texto,ss){
 const d=validarGreenAcres_(texto),sh=ss.getSheetByName('Green-Acres - recolhas');if(sh&&sh.getLastRow()&&sh.getRange(1,1,1,12).getDisplayValues()[0].join('|')!==GA_HEADERS.join('|'))throw Error('A estrutura das recolhas Green-Acres mudou.');
 const hash=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,JSON.stringify(d)).map(b=>('0'+(b&255).toString(16)).slice(-2)).join(''),duplicada=!!(sh&&sh.getLastRow()>1&&sh.getRange(2,11,sh.getLastRow()-1,1).getValues().some(r=>r[0]===hash));
 const names={visitas:['visitantes_unicos_diarios'],emails:['emails'],listas:['visualizacoes_lista'],anuncios:['anuncios_green_acres','anuncios_vizzit'],mensal:['visitas','contactos']},linhas=[];
 d.relatorios.forEach(r=>r.linhas.forEach(row=>row.valores.forEach((v,i)=>linhas.push([d.lido,'Conta '+d.conta,r.codigo==='mensal'?'Conforme relatório mensal':'all',r.codigo,r.inicio,r.fim,row.data,names[r.codigo][i],v,r.codigo==='mensal'?'Mensal; mês da recolha parcial':r.faltamDias?'Série com '+r.faltamDias+' dias em falta; não assumir zero':'Datas do CSV sem lacunas internas',hash,'CSV oficial Green-Acres']))));
 return{d,hash,linhas,duplicada};
}
function analisarGreenAcres(texto){if(JSON.parse(texto.slice(7)).tipo==='anuncios')return analisarAnunciosGreen_(texto);const p=prepararGreenAcres_(texto,SpreadsheetApp.getActive());return{origem:'green-acres',quantidade:p.d.relatorios.length,conta:p.d.conta,duplicada:p.duplicada,relatorios:p.d.relatorios.map(r=>({codigo:r.codigo,inicio:r.inicio,fim:r.fim,quantidade:r.linhas.length,faltamDias:r.faltamDias})),destino:'Green-Acres - recolhas',aviso:'CSV oficiais da conta Green-Acres. Séries diárias com a seleção «todos os sites» do portal. O relatório mensal mantém o âmbito definido pelo portal; o mês corrente é parcial.'};}
function gravarGreenAcresDados_(texto,ss){
 if(JSON.parse(texto.slice(7)).tipo==='anuncios')return gravarAnunciosGreenDados_(texto,ss);
 const inicio=Date.now(),p=prepararGreenAcres_(texto,ss),preparacaoMs=Date.now()-inicio,escrita=Date.now();if(p.duplicada)return{origem:'green-acres',duplicada:true,escritos:0,tempos:{preparacaoMs,escritaConferenciaMs:0,dashboardMs:0}};let sh=ss.getSheetByName('Green-Acres - recolhas');if(!sh){sh=ss.insertSheet('Green-Acres - recolhas');sh.getRange(1,1,1,12).setValues([GA_HEADERS]);sh.setFrozenRows(1);sh.getRange(1,1,1,12).setFontWeight('bold').setBackground('#155c53').setFontColor('#ffffff');}
 const start=sh.getLastRow()+1,n=p.linhas.length;if(sh.getMaxRows()<start+n-1)sh.insertRowsAfter(sh.getMaxRows(),start+n-1-sh.getMaxRows());
 try{sh.getRange(start,1,n,12).setValues(p.linhas.map(row=>row.map(v=>typeof v==='string'?"'"+v:v)));SpreadsheetApp.flush();const back=sh.getRange(start,1,n,12).getValues();if(JSON.stringify(back)!==JSON.stringify(p.linhas))throw Error('A conferência Green-Acres falhou.');}catch(e){sh.getRange(start,1,n,12).clearContent();throw e;}
 return{origem:'green-acres',duplicada:false,escritos:n,tempos:{preparacaoMs,escritaConferenciaMs:Date.now()-escrita,dashboardMs:0},cobertura:'5 CSV oficiais guardados. Dias em falta preservados; mês corrente parcial. Dados pessoais não recolhidos.'};
}
function gravarGreenAcres(texto){const inicio=Date.now(),lock=LockService.getDocumentLock();if(!lock.tryLock(30000))throw Error('Outra gravação em curso.');let result;try{result=gravarGreenAcresDados_(texto,SpreadsheetApp.getActive());}finally{lock.releaseLock();}const dashboard=Date.now();if(!result.duplicada&&result.tipo!=='anuncios')try{const r=atualizarDashboardSeNecessario();result.dashboardReutilizado=!!(r&&r.reutilizado);if(r&&r.adiado)result.cobertura+=' Dashboard será atualizado na próxima abertura.';}catch(e){result.cobertura+=' Dashboard por atualizar: '+e.message;}result.tempos.dashboardMs=Date.now()-dashboard;result.tempos.totalMs=Date.now()-inicio;return result;}

function serieMensalGreenAcres_(rows){
 const batches={};rows.forEach((r,i)=>{if(r[3]!=='mensal'||!r[10])return;const b=batches[r[10]]||(batches[r[10]]={conta:String(r[1]),recolha:String(r[0]),ordem:i,meses:{}}),m=b.meses[String(r[6])]||(b.meses[String(r[6])]={mes:String(r[6]).slice(0,7)});b.ordem=i;if(['visitas','contactos'].includes(r[7])&&typeof r[8]==='number'&&r[8]>=0)m[r[7]]=r[8];});
 const all=Object.values(batches).filter(b=>Object.values(b.meses).every(m=>typeof m.visitas==='number'&&typeof m.contactos==='number')).sort((a,b)=>b.recolha.localeCompare(a.recolha)||b.ordem-a.ordem);if(!all.length)return null;const b=all[0];return{conta:b.conta,recolha:b.recolha,meses:Object.values(b.meses).sort((a,b)=>a.mes.localeCompare(b.mes)).map(m=>Object.assign(m,{parcial:m.mes===b.recolha.slice(0,7)}))};
}
