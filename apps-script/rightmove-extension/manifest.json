{
  "manifest_version": 3,
  "name": "Clara · imóveis e Rightmove",
  "version": "0.2.0",
  "description": "Lê fichas públicas de imóveis e relatórios Rightmove para rever no Sheets.",
  "permissions": [
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://rmplusportal.rightmove.co.uk/*",
    "https://admin.rightmove.co.uk/*",
    "https://www.janela-imobiliaria.com/*",
    "https://janela-imobiliaria.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clara · imóveis e Rightmove"
  },
  "minimum_chrome_version": "102"
}
