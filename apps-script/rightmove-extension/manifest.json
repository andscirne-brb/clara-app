{
  "manifest_version": 3,
  "name": "Clara · Rightmove",
  "version": "0.1.2",
  "description": "Recolha manual conjunta de leads agregadas e Property Performance para rever no Sheets.",
  "permissions": [
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://rmplusportal.rightmove.co.uk/*",
    "https://admin.rightmove.co.uk/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clara · Rightmove"
  },
  "minimum_chrome_version": "102"
}